{
  "schemaVersion": 1,
  "id": "moss.ioa",
  "displayName": "零信任安全 iOA",
  "description": "提供零信任接入、终端管控、安全防护、数据防泄密等核心安全能力的管理操作",
  "category": "diagnostics",
  "discovery": {
    "group": "online",
    "authMethods": [
      "browser"
    ]
  },
  "keywords": [
    "ioa",
    "iOA Zero Trust",
    "mcp",
    "cli"
  ],
  "icon": "assets/icon.png",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "ioa",
    "source": "ioa",
    "name": "零信任安全 iOA",
    "nameEn": "iOA Zero Trust",
    "description": "提供零信任接入、终端管控、安全防护、数据防泄密等核心安全能力的管理操作",
    "descriptionEn": "It provides management and operation capabilities for core security features such as zero-trust access, endpoint control, security protection, and data leakage prevention.",
    "type": "mcp",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "5.0.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "帮我查询 iOA 当前账号分组信息",
      "帮我盘点 iOA 终端资产列表",
      "查看公司全员安装 iOA 客户端的覆盖率"
    ],
    "hasMcp": true,
    "hasCli": true,
    "hasSkills": false,
    "hasCredentialSchema": false,
    "icon": "data:image/png;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": true,
    "mcpServerNames": [
      "ioa-mcp"
    ],
    "skillName": "",
    "skillNames": []
  },
  "mcp": {
    "mcpServers": {
      "ioa-mcp": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@ioacloud/ioacloud-mcp@latest"
        ]
      }
    }
  },
  "cli": {
    "runtime": {
      "type": "node",
      "version": ">=18"
    },
    "init": {
      "darwin": "npm install -g @ioacloud/ioacloud-cli@latest",
      "linux": "npm install -g @ioacloud/ioacloud-cli@latest",
      "win32": "npm install -g @ioacloud/ioacloud-cli@latest"
    },
    "versionCheck": {
      "command": {
        "darwin": "ioacloud-cli --version",
        "linux": "ioacloud-cli --version",
        "win32": "ioacloud-cli.cmd --version"
      },
      "minVersion": "1.0.18"
    },
    "auth": {
      "darwin": "ioacloud-cli login --yes",
      "linux": "ioacloud-cli login --yes",
      "win32": "ioacloud-cli.cmd login --yes"
    },
    "unAuth": {
      "darwin": "ioacloud-cli logout --yes",
      "linux": "ioacloud-cli logout --yes",
      "win32": "ioacloud-cli.cmd logout --yes"
    },
    "status": {
      "darwin": "ioacloud-cli status",
      "linux": "ioacloud-cli status",
      "win32": "ioacloud-cli.cmd status"
    },
    "authWaitForExit": true,
    "authSuppressBrowser": true,
    "authUrlDomain": "console.cloud.tencent.com"
  }
}
