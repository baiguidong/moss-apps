{
  "schemaVersion": 1,
  "id": "moss.sequential-thinking",
  "version": "0.1.5",
  "displayName": "分步思考",
  "description": "按需为复杂分析提供步骤记录、修正和分支工具。",
  "category": "ai",
  "keywords": [
    "分步思考",
    "Sequential Thinking",
    "推理",
    "MCP"
  ],
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "runtime": {
    "state": "session"
  },
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.8.31"
      ],
      "env": {
        "DISABLE_THOUGHT_LOGGING": "true"
      }
    }
  },
  "presentation": {
    "headline": "为复杂任务记录步骤、修正与分支",
    "examples": [
      "逐步排查这个故障，记录假设并根据验证结果修正",
      "比较这几个方案，分别记录优缺点和适用条件",
      "把这个复杂任务拆成步骤，发现遗漏时回头调整"
    ],
    "usage": "启用并授权后，各会话均可按需使用，无需在会话中选择。每个会话独立保存临时步骤和分支；关闭会话运行时或重新启动服务后清空。"
  },
  "discovery": {
    "group": "local"
  }
}
