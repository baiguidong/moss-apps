  },
  "version": "0.1.1",
  "connector": {
    "id": "seeyon-office-marketing-suite",
    "source": "seeyon-office-marketing-suite",
    "name": "致远互联协同办公服务",
    "nameEn": "Seeyon Collaborative Office Services",
    "description": "为企业提供协同办公、会议和业务协同能力，支持用户用自然语言完成会议创建与查询、协同发起与跟进、和业务数据分析。",
    "descriptionEn": "Provides enterprises with collaborative office, meeting, and business collaboration capabilities, enabling users to create and query meetings, initiate and follow up on collaborations, and analyze business data using natural language.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "5.0.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "查询我本周已经发起的会议",
      "分析销售订单的发货和回款情况",
      "把销售分析报告发协同给销售负责人"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "seeyon-collaborative-office-loop-skill",
    "skillNames": [
      "seeyon-collaborative-office-loop-skill",
      "seeyon-marketing-data-analysis-skill"
    ]
  },
  "cli": {
    "runtime": {
      "type": "node",
      "version": ">=22"
    },
    "env": {
      "SEEYON_CONNECTOR_HOME": "$HOME/.workbuddy/connectors-marketplace/connectors/seeyon-office-marketing-suite"
    },
    "auth": {
      "darwin": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" auth",
      "linux": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" auth",
      "win32": "node \"%SEEYON_CONNECTOR_HOME%\\cli\\seeyon-connector.js\" auth"
    },
    "unAuth": {
      "darwin": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" logout",
      "linux": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" logout",
      "win32": "node \"%SEEYON_CONNECTOR_HOME%\\cli\\seeyon-connector.js\" logout"
    },
    "status": {
      "darwin": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" status",
      "linux": "node \"$SEEYON_CONNECTOR_HOME/cli/seeyon-connector.js\" status",
      "win32": "node \"%SEEYON_CONNECTOR_HOME%\\cli\\seeyon-connector.js\" status"
    },
    "statusMatchJson": {
      "authenticated": "true"
    },
    "statusMatch": "\"authenticated\"\\s*:\\s*true",
    "authWaitForExit": true,
    "authSuppressBrowser": true
  }
}
