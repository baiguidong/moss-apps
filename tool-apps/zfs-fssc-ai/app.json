{
  "schemaVersion": 1,
  "id": "moss.zfs-fssc-ai",
  "displayName": "中兴新云AI智报",
  "description": "财务云 AI 报销助手：用自然语言完成报销申请、发票查询识别、报销单查询与费用审批等操作。",
  "category": "business",
  "discovery": {
    "group": "online",
    "authMethods": [
      "credentials"
    ]
  },
  "keywords": [
    "zfs-fssc-ai",
    "ZTC AI Assistant",
    "mcp",
    "skills"
  ],
  "icon": "assets/icon.png",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "zfs-fssc-ai",
    "source": "zfs-fssc-ai",
    "name": "中兴新云AI智报",
    "nameEn": "ZTC AI Assistant",
    "description": "财务云 AI 报销助手：用自然语言完成报销申请、发票查询识别、报销单查询与费用审批等操作。",
    "descriptionEn": "ZTE FSSC AI reimbursement assistant: file reimbursements, recognize and query invoices, query expense bills and approve via natural language.",
    "type": "mcp",
    "authMode": "token",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.23.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "帮我查询本月已提交的报销单",
      "创建一张去北京出差的差旅报销单",
      "我有一笔餐费要报销，帮我走流程"
    ],
    "hasMcp": true,
    "hasCli": false,
    "hasSkills": true,
    "hasCredentialSchema": true,
    "icon": "data:image/png;base64,",
    "enabled": true,
    "credentialSchema": {
      "title": "财务云账号登录",
      "titleEn": "FSSC Account Login",
      "description": "连接您的财务云账号以使用 AI 智报。账号与密码仅用于向财务云登录换取会话凭证；密码不会被连接器存储，仅在服务端发起登录时使用。",
      "descriptionEn": "Connect your ZTE FSSC account to use AI reimbursement. Your credentials are used only to log in and obtain a session; the password is not persisted by this connector.",
      "docUrl": "",
      "docLabel": "",
      "docLabelEn": "",
      "fields": [
        {
          "key": "ZFS_LOGIN_KEY",
          "label": "财务云账号",
          "labelEn": "FSSC Account",
          "placeholder": "请输入您的账号",
          "placeholderEn": "Pelease enter your account",
          "description": "用于登录财务云的账号。",
          "descriptionEn": "Account used to log in to FSSC.",
          "type": "text",
          "required": true
        },
        {
          "key": "ZFS_PASSWORD",
          "label": "财务云密码",
          "labelEn": "FSSC Password",
          "placeholder": "请输入您的财务云登录密码",
          "placeholderEn": "Enter your FSSC login password",
          "description": "您的财务云登录密码。仅用于登录换取会话凭证，不会被平台保存。",
          "descriptionEn": "Your FSSC login password, used only to obtain a session and never persisted.",
          "type": "password",
          "required": true
        }
      ]
    },
    "requiresCliSetup": false,
    "mcpServerNames": [
      "zfs-fssc-ai"
    ],
    "skillName": "zfs-fssc-ai",
    "skillNames": [
      "zfs-fssc-ai"
    ]
  },
  "mcp": {
    "mcpServers": {
      "zfs-fssc-ai": {
        "type": "sse",
        "url": "https://mcpdemo.ztccloud.com.cn/sse",
        "headers": {
          "X-Zfs-Login-Key": "${ZFS_LOGIN_KEY}",
          "X-Zfs-Login-Password": "${ZFS_PASSWORD}"
        }
      }
    }
  }
}
