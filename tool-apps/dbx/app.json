{
  "schemaVersion": 1,
  "id": "moss.dbx",
  "version": "0.1.3",
  "displayName": "DBX MCP",
  "description": "通过原版 DBX MCP 查看数据库连接、表结构并执行数据库操作。",
  "category": "data",
  "keywords": [
    "DBX",
    "数据库",
    "SQL",
    "MySQL",
    "PostgreSQL",
    "Redis",
    "MongoDB",
    "MCP"
  ],
  "icon": "assets/icon.png",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "runtime": {
    "state": "session"
  },
  "mcpServers": {
    "dbx": {
      "command": "node",
      "args": [
        "@app/runtime/node_modules/@dbx-app/mcp-server/bin/dbx-mcp-server.js",
        "--stdio"
      ]
    }
  },
  "presentation": {
    "headline": "在对话中使用 DBX 数据库工具",
    "examples": [
      "列出 DBX 中允许 AI 使用的数据库连接",
      "查看这个数据库的表和字段，解释表之间的关系",
      "执行只读 SQL，统计最近一个月的订单数量"
    ],
    "usage": "点击「试用」或示例，在主会话中描述要查询的数据库、表结构或数据。需要调整连接时，打开「连接设置」。数据库操作遵循 DBX 中配置的访问权限和读写策略。"
  },
  "discovery": {
    "group": "local"
  }
}
