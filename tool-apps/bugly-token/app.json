    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "bugly-token",
    "source": "bugly-token",
    "name": "Bugly 质量概览",
    "nameEn": "Bugly Quality Overview",
    "description": "查看产品的质量概览 包括崩溃率 anr率 foom（oom）率 启动耗时",
    "descriptionEn": "View the product quality overview, including crash rate, ANR rate, FOOM (OOM) rate, and startup latency.",
    "type": "mcp",
    "authMode": "token",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.24.0",
    "visibleIn": [
      "internal"
    ],
    "examples": [
      "查看应用的大盘质量概览",
      "查看应用的版本质量概览",
      "查看应用的今天质量概览"
    ],
    "hasMcp": true,
    "hasCli": false,
    "hasSkills": true,
    "hasCredentialSchema": true,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": {
      "title": "Bugly 质量概览 MCP 对接配置",
      "titleEn": "Bugly Quality Overview MCP Configuration",
      "description": "连接您的 Bugly 账号，用于查看产品的崩溃率、ANR 率、FOOM（OOM）率与启动耗时等质量概览。Token 仅存储在本机 ~/.workbuddy 下，不会上传云端。",
      "descriptionEn": "Connect your Bugly account to view product quality overview such as crash rate, ANR rate, FOOM (OOM) rate, and startup latency. Token are stored locally in ~/.workbuddy only and are never uploaded to the cloud.",
      "docUrl": "https://bugly.tds.qq.com/v2/user/token",
      "docLabel": "如何获取 Bugly Access Token？",
      "docLabelEn": "How to get Bugly Access Token?",
      "fields": [
        {
          "key": "BUGLY_ACCESS_TOKEN",
          "label": "密钥",
          "labelEn": "",
          "placeholder": "在 Bugly 控制台 → 右上角头像 → 个人令牌→ 复制密钥",
          "placeholderEn": "In Bugly Console -> top-right avatar -> Personal Tokens -> copy the key",
          "description": "用于访问 Bugly OpenAPI 的个人访问令牌，将以 Authorization: Bearer 形式注入请求头。",
          "descriptionEn": "Personal access token for Bugly OpenAPI, injected into the request header as Authorization: Bearer.",
          "type": "password",
          "required": true
        }
      ]
    },
    "requiresCliSetup": false,
    "mcpServerNames": [
      "bugly"
    ],
    "skillName": "bugly-quality-overview",
    "skillNames": [
      "bugly-quality-overview"
    ]
  },
  "mcp": {
    "mcpServers": {
      "bugly": {
        "type": "http",
        "url": "https://bugly.tds.qq.com/mcp",
        "headers": {
          "Authorization": "Bearer ${BUGLY_ACCESS_TOKEN}"
        }
      }
    }
  }
}
