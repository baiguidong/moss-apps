  "cli": {
    "runtime": {
      "type": "node",
      "version": ">=18"
    },
    "versionCheck": {
      "command": {
        "darwin": "miaoda --version",
        "linux": "miaoda --version",
        "win32": "miaoda.cmd --version"
      },
