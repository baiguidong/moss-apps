{
  "schemaVersion": 1,
  "id": "moss.emr-query",
  "displayName": "弹性MapReduce",
  "description": "通过CLI实现弹性 MapReduce 集群、节点、服务、作业、监控、YARN 调度、自动扩缩容、用户与配置等查询。",
  "category": "data",
  "discovery": {
    "group": "online",
    "authMethods": [
      "browser"
    ]
  },
  "keywords": [
    "emr-query",
    "Elastic MapReduce",
    "cli",
    "skills"
  ],
  "icon": "assets/icon.svg",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "emr-query",
    "source": "emr-query",
    "name": "弹性MapReduce",
    "nameEn": "Elastic MapReduce",
    "description": "通过CLI实现弹性 MapReduce 集群、节点、服务、作业、监控、YARN 调度、自动扩缩容、用户与配置等查询。",
    "descriptionEn": "Query Elastic MapReduce (EMR) clusters, nodes, services, jobs, monitoring, YARN scheduling, auto-scaling, users, and configurations via CLI.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "5.3.10",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "查看我所有的 EMR 集群列表",
      "查询集群 emr-e3orculh 的节点信息",
      "获取最近一天的 Spark 查询任务",
      "查看集群的巡检结果和 EMR 事件",
      "查询 YARN 队列和自动扩缩容记录"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "emr-query-skill",
    "skillNames": [
      "emr-query-skill"
    ]
  },
  "cli": {
    "runtime": {
      "type": "python",
      "version": ">=3.11"
    },
    "init": {
      "darwin": "python -m pip install --upgrade tccli",
      "linux": "python -m pip install --upgrade tccli",
      "win32": "python -m pip install --upgrade tccli"
    },
    "auth": {
      "darwin": "tccli auth login",
      "linux": "tccli auth login",
      "win32": "tccli auth login"
    },
    "unAuth": {
      "darwin": "tccli auth logout || true",
      "linux": "tccli auth logout || true",
      "win32": "tccli auth logout"
    },
    "status": {
      "darwin": "tccli emr DescribeInstancesList --region ap-guangzhou --version 2019-01-03 --cli-unfold-argument --DisplayStrategy clusterList --Limit 1 >/dev/null 2>&1 && echo 'Authenticated and EMR accessible' || (echo 'Not authenticated or no EMR access' >&2; exit 1)",
      "linux": "tccli emr DescribeInstancesList --region ap-guangzhou --version 2019-01-03 --cli-unfold-argument --DisplayStrategy clusterList --Limit 1 >/dev/null 2>&1 && echo 'Authenticated and EMR accessible' || (echo 'Not authenticated or no EMR access' >&2; exit 1)",
      "win32": "powershell -Command \"tccli emr DescribeInstancesList --region ap-guangzhou --version 2019-01-03 --cli-unfold-argument --DisplayStrategy clusterList --Limit 1 *> $null; if ($LASTEXITCODE -eq 0) { Write-Output 'Authenticated and EMR accessible'; exit 0 } else { Write-Error 'Not authenticated or no EMR access'; exit 1 }\""
    },
    "authUrlDomain": "cloud.tencent.com",
    "statusMatch": "Authenticated and EMR accessible",
    "authWaitForExit": true,
    "authSuppressBrowser": true,
    "versionCheck": {
      "command": {
        "darwin": "tccli --version",
        "linux": "tccli --version",
        "win32": "tccli --version"
      },
      "minVersion": "3.1.56.1",
      "versionPattern": "(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)"
    }
  }
}
