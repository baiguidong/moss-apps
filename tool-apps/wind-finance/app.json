    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "wind-finance",
    "source": "wind-finance",
    "name": "Wind 金融数据",
    "nameEn": "Wind Financial Data",
    "description": "通过自然语言查询股票、基金、指数、债券、公告、财经新闻和宏观经济数据。",
    "descriptionEn": "Wind data for stocks, funds, indices, bonds, news, and macroeconomics.",
    "type": "mcp",
    "authMode": "token",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.23.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "筛选沪深市场市值超过500亿且连续5日上涨的股票",
      "查询贵州茅台2024年ROE、营业收入和净利润",
      "查询沪深300最近20日的MACD和涨跌幅",
      "查询中国GDP最近10期数据"
    ],
    "hasMcp": true,
    "hasCli": false,
    "hasSkills": true,
    "hasCredentialSchema": true,
    "icon": "data:image/png;base64,",
    "enabled": true,
    "credentialSchema": {
      "title": "Wind 金融数据 MCP 配置",
      "titleEn": "Wind Financial Data MCP Configuration",
      "description": "填写 Wind API Key 以启用万得金融数据查询，支持股票、债券、基金、指数、宏观数据的查询与分析。Key 仅保存在本机 ~/.workbuddy 下，不会上传云端。",
      "descriptionEn": "Enter your Wind API Key to enable financial data query and analysis across stocks, bonds, funds, indices, and macro indicators. The key is stored locally at ~/.workbuddy and never leaves your device.",
      "docUrl": "https://aifinmarket.wind.com.cn/#/user/overview",
      "docLabel": "如何获取 API Key？",
      "docLabelEn": "How to get an API Key?",
      "fields": [
        {
          "key": "WIND_API_KEY",
          "label": "Wind API Key（个人密钥）",
          "labelEn": "",
          "placeholder": "请输入您的个人 Wind API Key",
          "placeholderEn": "Enter your personal Wind API Key",
          "description": "用于访问Wind MCP 的个人访问令牌。",
          "descriptionEn": "Personal access token for accessing the Wind MCP.",
          "type": "password",
          "required": true
        }
      ]
    },
    "requiresCliSetup": false,
    "mcpServerNames": [
      "wind-finance"
    ],
    "skillName": "wind-finance",
    "skillNames": [
      "wind-finance"
    ]
  },
  "mcp": {
    "mcpServers": {
      "wind-finance": {
        "type": "http",
        "url": "https://mcp.wind.com.cn/vserver_workbuddy/mcp/",
        "headers": {
          "Authorization": "Bearer ${WIND_API_KEY}",
          "Accept": "application/json, text/event-stream"
        }
      }
    }
  }
}
