{
  "schemaVersion": 1,
  "id": "moss.git",
  "version": "0.1.4",
  "displayName": "Git 仓库",
  "description": "默认在当前会话目录查看 Git 改动、提交和管理分支，也可显式选择公共仓库。",
  "category": "development",
  "keywords": [
    "Git 仓库",
    "Git",
    "MCP"
  ],
  "icon": "assets/icon.svg",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "runtime": {
    "state": "stateless"
  },
  "mcpServers": {
    "git": {
      "command": "python3",
      "args": [
        "-I",
        "-m",
        "mcp_server_git"
      ],
      "python": {
        "requirements": [
          "mcp-server-git==2026.8.18"
        ]
      },
      "roots": {
        "includeWorkspace": true,
        "delivery": "roots",
        "directories": []
      },
      "pathBindings": [
        {
          "argument": "repo_path",
          "kind": "git-repository",
          "executable": ""
        }
      ]
    }
  },
  "presentation": {
    "headline": "在会话仓库中查看改动、提交和管理分支",
    "examples": [
      "检查当前会话仓库的修改，解释改动内容",
      "查看最近的提交和分支",
      "将指定文件暂存并提交，保留其他修改"
    ],
    "usage": "默认使用当前会话的工作目录，只有明确指定仓库路径时才选择其他仓库。公共仓库可在设置中添加，不会自动回退到公共仓库。Git 默认从 PATH 查找，也可指定程序路径。"
  },
  "discovery": {
    "group": "local"
  }
}
