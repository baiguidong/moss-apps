{
  "schemaVersion": 1,
  "id": "moss.beisen-cli",
  "displayName": "北森AI · HR专家",
  "description": "依托北森HR SaaS平台，把审批、招聘进展、员工档案、绩效履历、考勤假期、组织架构和企业制度等近百个人力场景装进Workbuddy，一句话查询人力数据、办理HR业务。",
  "category": "hr",
  "discovery": {
    "group": "online",
    "authMethods": [
      "browser"
    ]
  },
  "keywords": [
    "beisen-cli",
    "Beisen AI·HR Expert",
    "cli",
    "skills"
  ],
  "icon": "assets/icon.png",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "beisen-cli",
    "source": "beisen-cli",
    "name": "北森AI · HR专家",
    "nameEn": "Beisen AI·HR Expert",
    "description": "依托北森HR SaaS平台，把审批、招聘进展、员工档案、绩效履历、考勤假期、组织架构和企业制度等近百个人力场景装进Workbuddy，一句话查询人力数据、办理HR业务。",
    "descriptionEn": "Relying on the Beisen HR SaaS platform, we have integrated nearly a hundred HR scenarios—including approvals, recruitment progress, employee profiles, performance records, attendance and leave, organizational structure, and corporate policies—into Workbuddy. This enables you to query HR data and handle HR tasks with just a single sentence.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "5.3.10",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "帮我查下我有哪些待办/已办？",
      "我上个月有没有迟到，或者忘记打卡？",
      "我团队上月的公出、出差情况",
      "我要开证明",
      "公积金提取政策是什么？",
      "搜索一下关于年假制度的知识文档",
      "我负责的在招职位现在整体进展怎么样？",
      "我今天有几场面试？都是几点？",
      "帮我找一批 3-5 年经验、本科以上、有B端产品经验的候选人",
      "查看我已办的审批流程"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/png;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "beisen-approval",
    "skillNames": [
      "beisen-approval",
      "beisen-attendance-leave",
      "beisen-data-query",
      "beisen-employee-profile",
      "beisen-interview",
      "beisen-knowledge",
      "beisen-organization",
      "beisen-recruitment",
      "beisen-service-portal",
      "beisen-shared"
    ]
  },
  "cli": {
    "init": {
      "darwin": "npm install -g beisen-cli",
      "linux": "npm install -g beisen-cli",
      "win32": "npm install -g beisen-cli"
    },
    "auth": {
      "darwin": "beisen-cli auth login",
      "linux": "beisen-cli auth login",
      "win32": "beisen-cli auth login"
    },
    "unAuth": {
      "darwin": "beisen-cli auth logout",
      "linux": "beisen-cli auth logout",
      "win32": "beisen-cli auth logout"
    },
    "status": {
      "darwin": "beisen-cli auth status",
      "linux": "beisen-cli auth status",
      "win32": "beisen-cli auth status"
    },
    "statusMatchJson": {
      "status": "valid"
    },
    "authUrlDomain": "login.italent.cn",
    "authWaitForExit": true,
    "authSuppressBrowser": false,
    "runtime": {
      "type": "node",
      "version": ">=22.20.0"
    },
    "versionCheck": {
      "command": {
        "darwin": "beisen-cli version",
        "linux": "beisen-cli version",
        "win32": "beisen-cli version"
      },
      "minVersion": "1.0.5",
      "versionPattern": "(\\d+\\.\\d+\\.\\d+)"
    }
  }
}
