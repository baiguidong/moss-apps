{
  "schemaVersion": 1,
  "id": "moss.woscli",
  "displayName": "微盟 WOS CLI",
  "description": "通过自然语言调用 woscli 操作微盟 WOS 业务能力：查询与管理订单、商品、客户资料、营销活动、数据看板等。",
  "category": "marketing",
  "discovery": {
    "group": "online",
    "authMethods": [
      "browser"
    ]
  },
  "keywords": [
    "woscli",
    "Weimob WOS CLI",
    "cli",
    "skills"
  ],
  "icon": "assets/icon.png",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "woscli",
    "source": "woscli",
    "name": "微盟 WOS CLI",
    "nameEn": "Weimob WOS CLI",
    "description": "通过自然语言调用 woscli 操作微盟 WOS 业务能力：查询与管理订单、商品、客户资料、营销活动、数据看板等。",
    "descriptionEn": "Execute Weimob WOS business commands with natural language via woscli: orders, goods, customers, marketing, dashboards, and more.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.24.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "查询我最近的订单列表",
      "帮我创建一个商品并上架",
      "查看客户 xxx 的基本资料与组织关系",
      "列出当前可用的营销活动"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/png;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "woscli-usage",
    "skillNames": [
      "woscli-usage"
    ]
  },
  "cli": {
    "init": {
      "darwin": "curl -fsSL https://ipaas-huawei-cloud-1252328573.cos.ap-shanghai.myqcloud.com/wai/install.sh -o /tmp/woscli-install.sh && sh /tmp/woscli-install.sh",
      "linux": "curl -fsSL https://ipaas-huawei-cloud-1252328573.cos.ap-shanghai.myqcloud.com/wai/install.sh -o /tmp/woscli-install.sh && sh /tmp/woscli-install.sh",
      "win32": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://ipaas-huawei-cloud-1252328573.cos.ap-shanghai.myqcloud.com/wai/install.ps1 | iex\""
    },
    "auth": {
      "darwin": "$HOME/.woscli/woscli login",
      "linux": "$HOME/.woscli/woscli login",
      "win32": "%USERPROFILE%\\.woscli\\woscli.exe login"
    },
    "unAuth": {
      "darwin": "$HOME/.woscli/woscli logout",
      "linux": "$HOME/.woscli/woscli logout",
      "win32": "%USERPROFILE%\\.woscli\\woscli.exe logout"
    },
    "status": {
      "darwin": "$HOME/.woscli/woscli status",
      "linux": "$HOME/.woscli/woscli status",
      "win32": "%USERPROFILE%\\.woscli\\woscli.exe status"
    },
    "statusMatch": "已授权",
    "authUrlDomain": "weimob.com",
    "authSuppressBrowser": true,
    "versionCheck": {
      "command": {
        "darwin": "$HOME/.woscli/woscli --version",
        "linux": "$HOME/.woscli/woscli --version",
        "win32": "%USERPROFILE%\\.woscli\\woscli.exe --version"
      },
      "minVersion": "0.0.0",
      "versionPattern": "woscli version (v\\d+\\.\\d+\\.\\d+|v_\\d+_\\d+-[0-9]+-g[0-9a-f]+(?:-dirty)?)"
    }
  }
}
