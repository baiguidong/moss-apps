{
  "schemaVersion": 1,
  "id": "moss.zsxq",
  "displayName": "知识星球",
  "description": "用自然语言管理知识星球：浏览星球内容、发帖评论、搜索主题、回答问题、管理笔记、查看用户信息。",
  "category": "knowledge",
  "discovery": {
    "group": "online",
    "authMethods": [
      "browser"
    ]
  },
  "keywords": [
    "zsxq",
    "Zsxq",
    "cli",
    "skills"
  ],
  "icon": "assets/icon.svg",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "zsxq",
    "source": "zsxq",
    "name": "知识星球",
    "nameEn": "Zsxq",
    "description": "用自然语言管理知识星球：浏览星球内容、发帖评论、搜索主题、回答问题、管理笔记、查看用户信息。",
    "descriptionEn": "Manage Zsxq knowledge communities with natural language: browse groups, post topics, comment, answer questions, search content, manage notes, and view user profiles.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.24.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "列出我加入的所有星球",
      "帮我在「生财有术」搜索关于「跨境电商」的主题",
      "帮我发一篇帖子，标题是「今天的学习心得」",
      "查看我的知识星球用户资料",
      "帮我创建一条公开笔记，内容是本周的阅读总结",
      "看看最近大家在讨论什么热门话题"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "zsxq-skill",
    "skillNames": [
      "zsxq-skill"
    ]
  },
  "cli": {
    "runtime": {
      "type": "node",
      "version": ">=18"
    },
    "init": {
      "darwin": "npm install -g zsxq-cli",
      "linux": "npm install -g zsxq-cli",
      "win32": "npm install -g zsxq-cli"
    },
    "versionCheck": {
      "command": {
        "darwin": "zsxq-cli --version",
        "linux": "zsxq-cli --version",
        "win32": "zsxq-cli.cmd --version"
      },
      "minVersion": "0.5.0"
    },
    "auth": {
      "darwin": "zsxq-cli auth login --no-wait",
      "linux": "zsxq-cli auth login --no-wait",
      "win32": "zsxq-cli.cmd auth login --no-wait"
    },
    "unAuth": {
      "darwin": "zsxq-cli auth logout",
      "linux": "zsxq-cli auth logout",
      "win32": "zsxq-cli.cmd auth logout"
    },
    "status": {
      "darwin": "zsxq-cli auth status",
      "linux": "zsxq-cli auth status",
      "win32": "zsxq-cli.cmd auth status"
    },
    "authUrlDomain": "garden.zsxq.com",
    "authSuppressBrowser": true,
    "statusMatch": "Logged in as"
  }
}
