  },
  "version": "0.1.1",
  "connector": {
    "id": "lovrabet-cli",
    "source": "lovrabet-cli",
    "name": "Lovrabet CLI",
    "nameEn": "Lovrabet CLI",
    "description": "连接企业系统、数据和流程，让AI完成工作，交付结果",
    "descriptionEn": "Connect enterprise systems, data, and workflows so AI can do the work and deliver results.",
    "type": "cli",
    "authMode": "",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.24.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "找出今天需要优先处理的异常订单，并生成处理清单",
      "把这批保单的最新跟进结果更新到业务系统，并返回更新摘要",
      "汇总本月续保和理赔情况，生成经营简报",
      "识别这些装修验收单，将关键信息写入项目记录，并列出异常项",
      "每天上午 9 点自动汇总昨日经营情况并发送提醒",
      "根据公司制度检查这份业务申请，给出问题和修改建议"
    ],
    "hasMcp": false,
    "hasCli": true,
    "hasSkills": true,
    "hasCredentialSchema": false,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": null,
    "requiresCliSetup": false,
    "mcpServerNames": [],
    "skillName": "lovrabet",
    "skillNames": [
      "lovrabet"
    ]
  },
  "cli": {
    "init": {
      "darwin": "npm install -g @lovrabet/lovrabet-cli",
      "linux": "npm install -g @lovrabet/lovrabet-cli",
      "win32": "npm install -g @lovrabet/lovrabet-cli"
    },
    "auth": {
      "darwin": "lovrabet auth device --url-only --source workbuddy",
      "linux": "lovrabet auth device --url-only --source workbuddy",
      "win32": "lovrabet auth device --url-only --source workbuddy"
    },
    "authUrlDomain": "user.lovrabet.com",
    "unAuth": {
      "darwin": "lovrabet auth logout --global",
      "linux": "lovrabet auth logout --global",
      "win32": "lovrabet auth logout --global"
    },
    "status": {
      "darwin": "lovrabet auth status --global --check",
      "linux": "lovrabet auth status --global --check",
      "win32": "lovrabet auth status --global --check"
    },
    "statusMatch": "Status: valid",
    "runtime": {
      "type": "node",
      "version": ">=20"
    },
    "versionCheck": {
      "command": {
        "darwin": "lovrabet --version",
        "linux": "lovrabet --version",
        "win32": "lovrabet --version"
      },
      "minVersion": "2.2.7"
    }
  }
}
