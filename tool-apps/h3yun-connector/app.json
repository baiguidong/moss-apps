{
  "schemaVersion": 1,
  "id": "moss.h3yun-connector",
  "displayName": "氚云",
  "description": "通过氚云连接器，将日常业务快速构建为可配置、可协同、可追踪的数字化应用。支持快速创建应用表单、管理业务数据、以流程驱动审批与任务流转，适用于客户、项目、采购、库存、售后等多类业务管理场景。",
  "category": "automation",
  "discovery": {
    "group": "online",
    "authMethods": [
      "api-key"
    ]
  },
  "keywords": [
    "h3yun-connector",
    "H3Yun",
    "mcp",
    "skills"
  ],
  "icon": "assets/icon.svg",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "version": "0.1.1",
  "connector": {
    "id": "h3yun-connector",
    "source": "h3yun-connector",
    "name": "氚云",
    "nameEn": "H3Yun",
    "description": "通过氚云连接器，将日常业务快速构建为可配置、可协同、可追踪的数字化应用。支持快速创建应用表单、管理业务数据、以流程驱动审批与任务流转，适用于客户、项目、采购、库存、售后等多类业务管理场景。",
    "descriptionEn": "With the H3Yun connector, businesses can quickly turn everyday operations into configurable, collaborative, and traceable digital applications. It supports rapid app creation, business data management, and workflow-driven approvals and task routing, making it suitable for a wide range of scenarios including customer, project, procurement, inventory, and after-sales management.",
    "type": "mcp",
    "authMode": "token",
    "providerId": "",
    "authConfig": null,
    "minWorkbuddyVersion": "4.23.0",
    "visibleIn": [
      "internal",
      "iOA",
      "cloudhosted",
      "selfhosted"
    ],
    "examples": [
      "帮我了解今日的待办",
      "帮我搭建一个项目管理系统",
      "帮我分析本月的销售经营数据，生成经营建议"
    ],
    "hasMcp": true,
    "hasCli": false,
    "hasSkills": true,
    "hasCredentialSchema": true,
    "icon": "data:image/svg+xml;base64,",
    "enabled": true,
    "credentialSchema": {
      "title": "氚云 MCP 对接配置",
      "titleEn": "H3Yun MCP Configuration",
      "description": "连接您的 氚云 账号，用于查询业务数据和待办。Token 和 Base Url 仅存储在本机 ~/.workbuddy 下。",
      "descriptionEn": "Connect your H3Yun account to query business data and to-do tasks. Token and Base Url are stored locally in ~/.workbuddy on this machine only.",
      "docUrl": "https://help.h3yun.com/280976225/",
      "docLabel": "如何获取 氚云 个人Token？",
      "docLabelEn": "How to get H3Yun personal token?",
      "fields": [
        {
          "key": "H3YUN_TOKEN",
          "label": "个人Token",
          "labelEn": "Personal Token",
          "placeholder": "在 氚云个人信息 → 用户访问凭证 → 管理凭证 中生成",
          "placeholderEn": "Generate in H3Yun Personal Information → User Access Credentials → Manage Credentials",
          "description": "用于访问 氚云 的个人访问令牌。",
          "descriptionEn": "Personal access token for H3Yun.",
          "type": "password",
          "required": true
        },
        {
          "key": "H3YUN_API_BASE_URL",
          "label": "业务基础地址",
          "labelEn": "Business Base URL",
          "placeholder": "www.h3yun.com",
          "placeholderEn": "",
          "description": "氚云 MCP服务地址",
          "descriptionEn": "H3Yun MCP service address.",
          "type": "text",
          "required": false,
          "defaultValue": "www.h3yun.com"
        }
      ]
    },
    "requiresCliSetup": false,
    "mcpServerNames": [
      "h3yun-connector"
    ],
    "skillName": "connector-h3yun-connector",
    "skillNames": [
      "connector-h3yun-connector"
    ]
  },
  "mcp": {
    "mcpServers": {
      "h3yun-connector": {
        "type": "http",
        "url": "https://${H3YUN_API_BASE_URL}/v1/agent/mcp",
        "headers": {
          "Authorization": "Bearer ${H3YUN_TOKEN}"
        }
      }
    }
  }
}
