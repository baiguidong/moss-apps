  "cli": {
    "init": {
      "darwin": "curl -fsSL https://aigc-assets.mgtv.com/mglc/install.sh | bash",
      "linux": "curl -fsSL https://aigc-assets.mgtv.com/mglc/install.sh | bash",
      "win32": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"iwr https://aigc-assets.mgtv.com/mglc/install.ps1 -UseBasicParsing | iex\""
    },
    "auth": {
      "darwin": "mglc auth --source workbuddy",
      "linux": "mglc auth --source workbuddy",
      "win32": "mglc.exe auth --source workbuddy"
    },
    "unAuth": {
      "darwin": "mglc logout",
      "linux": "mglc logout",
      "win32": "mglc.exe logout"
    },
