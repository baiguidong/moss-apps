{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moss.local/schemas/app-manifest-v2.json",
  "title": "Moss App Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "hostApi", "permissions"],
  "anyOf": [{ "required": ["ui"] }, { "required": ["backend"] }],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$" },
    "version": { "type": "string" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "icon": { "type": "string" },
    "hostApi": { "type": "string" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9:._-]*$"
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "route": { "type": "string", "pattern": "^#/", "maxLength": 256 },
              "location": { "enum": ["sidebar", "more", "hidden"] },
              "icon": { "type": "string", "maxLength": 80 },
              "order": { "type": "integer", "minimum": -10000, "maximum": 10000 },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "viewId"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "viewId": { "type": "string", "maxLength": 80 },
              "order": { "type": "integer", "minimum": -10000, "maximum": 10000 },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "action"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "description": { "type": "string", "maxLength": 1000 },
              "action": { "type": "string", "maxLength": 128 },
              "inputSchema": { "type": "string" },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description", "action", "inputSchema", "effect"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "action": { "type": "string", "maxLength": 128 },
              "inputSchema": { "type": "string" },
              "outputSchema": { "type": "string" },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 },
              "effect": { "enum": ["read", "write", "destructive"] }
            }
          }
        },
        "resourceProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "schemes", "resolveAction"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "schemes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]{1,31}$" }
              },
              "resolveAction": { "type": "string", "maxLength": 128 },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "viewId", "placement"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "viewId": { "type": "string", "maxLength": 80 },
              "placement": { "enum": ["overlay", "status"] },
              "permission": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
            "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
            "resizable": { "type": "boolean" }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "runtime", "apiVersion", "lifecycle", "actions"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "runtime": { "const": "node" },
        "apiVersion": { "const": 1 },
        "lifecycle": { "enum": ["on-demand", "persistent"] },
        "instanceMode": { "const": "single", "description": "Legacy field; each App has one Backend and new manifests omit this field." },
        "protocols": {
          "description": "Host protocols available to the Desktop Backend.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,94}[a-z0-9])?/v[1-9][0-9]*$"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
              "inputSchema": { "type": "string" },
              "outputSchema": { "type": "string" },
              "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "type": "string" },
            "secrets": { "type": "string" }
          }
        }
      }
    }
  }
}
