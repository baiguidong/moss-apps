{
  "name": "moss-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "vendor/moss-core/packages/app-sdk"
  ],
  "scripts": {
    "validate": "node scripts/validate-apps.mjs",
    "check": "node scripts/run-apps.mjs check",
    "test": "bun test scripts && node scripts/run-apps.mjs test",
    "build": "node scripts/run-apps.mjs build",
    "package": "node scripts/package-app.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "keys:generate": "node scripts/generate-signing-key.mjs"
  },
  "devDependencies": {
    "@moss/app-sdk": "workspace:*",
    "fflate": "^0.8.2",
    "semver": "^7.7.4"
  }
}
