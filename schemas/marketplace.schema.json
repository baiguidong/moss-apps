{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baiguidong.github.io/moss-apps/schemas/marketplace-v1.json",
  "title": "Moss App marketplace metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "summary", "categories", "platforms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 8000 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["darwin-arm64", "darwin-x64", "win32-x64", "win32-arm64", "linux-x64", "linux-arm64"] }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string", "maxLength": 80 },
    "featured": { "type": "boolean" },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
