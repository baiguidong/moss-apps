{
  "id": "h3c-cloudnet",
  "source": "h3c-cloudnet",
  "name": "新华三Cloudnet灵犀AI助手",
  "nameEn": "H3C Cloudnet LinSeer AI Assistant",
  "description": "面向网络运维场景的 AI 助手，支持网络运行状态查询、网络问题分析、设备/AP 信息查询和无线终端故障排查，帮助用户快速定位网络异常并获取处理建议。",
  "descriptionEn": "An AI-powered network operations assistant that provides network status queries, network issue analysis, device/AP information queries, and wireless terminal troubleshooting to help users quickly identify network anomalies and obtain resolution recommendations.",
  "type": "mcp",
  "authMode": "token",
  "providerId": "",
  "authConfig": null,
  "minWorkbuddyVersion": "4.23.0",
  "visibleIn": [
    "internal",
    "iOA",
    "cloudhosted",
    "selfhosted"
  ],
  "examples": [
    "排查成都实验局场所下，终端 001d-4330-0cbc 网络不好的原因",
    "查看成都实验局场所整体网络健康度，有哪些网络问题",
    "查询成都实验局场所今天每小时的接入成功率",
    "查询成都实验局场所的 AP 数量和在线情况",
    "查询设备 219801A5ND823CP002X3 的 CPU 和内存占用率"
  ],
  "hasMcp": true,
  "hasCli": false,
  "hasSkills": true,
  "hasCredentialSchema": true,
  "icon": "data:image/svg+xml;base64,",
  "enabled": true,
  "credentialSchema": {
    "title": "Cloudnet MCP 对接配置",
    "titleEn": "Cloudnet MCP Configuration",
    "description": "请填写 Cloudnet 管理平台的 API Key 和平台主机名。凭证仅存储在本机 ~/.workbuddy 下，不会上传云端。",
    "descriptionEn": "Please enter your Cloudnet API Key and platform host. Credentials are stored locally in ~/.workbuddy only.",
    "docUrl": "https://oasis.h3c.com/oasis6/static/#/net/set/apikey",
    "docLabel": "如何获取 Cloudnet API Key？",
    "docLabelEn": "How to get Cloudnet API Key?",
    "fields": [
      {
        "key": "CLOUDNET_API_KEY",
        "label": "API Key",
        "labelEn": "API Key",
        "placeholder": "在 Cloudnet 管理平台 → 网络管理 → 设置 → 开放平台 获取",
        "placeholderEn": "Get it from Cloudnet Console → Network Management → Settings → Open Platform",
        "description": "用于访问 Cloudnet OpenAPI 的 API Key，将写入 Authorization 请求头。",
        "descriptionEn": "API Key for Cloudnet OpenAPI, injected into the Authorization header.",
        "type": "password",
        "required": true
      },
      {
        "key": "CLOUDNET_BASE_URL",
        "label": "平台主机名",
        "labelEn": "Platform Host",
        "placeholder": "oasis.h3c.com",
        "placeholderEn": "oasis.h3c.com",
        "description": "Cloudnet 管理平台主机名（不含 https:// 前缀）。公网用户用默认值 oasis.h3c.com，私有部署用户填内网主机名。",
        "descriptionEn": "Cloudnet platform host (without https:// prefix). Public users use the default oasis.h3c.com; private deployment users enter the internal host.",
        "type": "text",
        "required": true,
        "defaultValue": "oasis.h3c.com"
      }
    ]
  },
  "requiresCliSetup": false,
  "mcpServerNames": [
    "h3c-cloudnet"
  ],
