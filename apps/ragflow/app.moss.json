{
  "schemaVersion": 2,
  "id": "moss.ragflow",
  "version": "0.1.0",
  "displayName": "RAGFlow 企业知识库",
  "description": "通过 Moss Server 登录态或 RAGFlow API Key 连接企业知识库，支持检索、文档管理、上传解析、聊天助手和 Agent。",
  "category": "knowledge",
  "discovery": {
    "group": "online",
    "authMethods": [
      "moss-session",
      "api-key"
    ]
  },
  "connectorApp": {
    "id": "ragflow",
    "capabilities": [
      "mcp",
      "skills"
    ]
  },
  "keywords": [
    "ragflow",
    "RAGFlow Knowledge Base",
    "mcp",
    "skills"
  ],
  "icon": "assets/icon.svg",
  "hostApi": "^3.15.0",
  "toolScope": "session",
  "navigation": {
    "location": "none"
  },
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "permissions": [
    "connector:use"
  ]
}
