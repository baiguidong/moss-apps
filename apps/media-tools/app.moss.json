{
  "schemaVersion": 2,
  "id": "moss.media-tools",
  "version": "0.1.0",
  "displayName": "音视频工坊",
  "category": "creative",
  "discovery": { "group": "local" },
  "keywords": [
    "FFmpeg",
    "视频裁剪",
    "音频提取",
    "视频压缩"
  ],
  "description": "使用 FFmpeg 裁剪、压缩、转换本地音视频。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1200,
      "height": 820,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "音视频工坊",
        "route": "#/",
        "order": 270
      }
    ],
    "tools": [
      {
        "id": "run",
        "title": "运行音视频工坊任务",
        "description": "以结构化请求执行本地引擎任务，支持高级参数并记录结果。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "task",
        "title": "查看音视频工坊任务",
        "description": "查看任务状态、运行参数和结果。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "catalog",
        "title": "查看音视频工坊能力",
        "description": "查看本地引擎版本和可用任务模式。",
        "action": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "list",
        "title": "列出音视频工坊任务",
        "description": "列出页面和 Agent 共享的最近任务。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "cancel",
        "title": "取消音视频工坊任务",
        "description": "取消指定的运行中任务。",
        "action": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "effect": "write"
      },
      {
        "id": "read-result",
        "title": "读取音视频工坊文本结果",
        "description": "读取指定任务的文本或 JSON 产物，单文件最大 2 MiB。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      }
    ],
    "skills": [
      {
        "id": "moss-media-tools",
        "title": "音视频工坊",
        "description": "通过受管 CLI 使用完整引擎参数并与页面共享任务结果。",
        "path": "resources/skills/moss-media-tools/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ]
  },
  "platforms": [
    "darwin-arm64"
  ]
}
