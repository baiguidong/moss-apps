{
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^(flow|run)_[a-f0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "submissionKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "workflowId",
    "revision",
    "task"
  ],
  "additionalProperties": false
}
