{
  "type": "object",
  "properties": {
    "operation": {
      "enum": [
        "list",
        "get",
        "runs",
        "run",
        "events",
        "resource",
        "revisions"
      ]
    },
    "workflowId": {
      "type": "string",
      "pattern": "^(flow|run)_[a-f0-9-]+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^(flow|run)_[a-f0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40000
    },
    "afterSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "resourceRef": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "includeArchived": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "running",
        "pausing",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    }
  },
  "required": [
    "operation"
  ],
  "additionalProperties": false
}
