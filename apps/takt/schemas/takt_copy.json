{
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^flow_[a-f0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "required": [
    "workflowId",
    "revision"
  ],
  "additionalProperties": false
}
