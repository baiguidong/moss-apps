{
  "schemaVersion": 2,
  "id": "moss.drive",
  "version": "0.3.8",
  "displayName": "网盘",
  "category": "knowledge",
  "keywords": [
    "网盘",
    "文件",
    "云端存储",
    "上传",
    "下载",
    "文件分享",
    "分享码"
  ],
  "description": "管理个人云端文件，上传、下载和分享。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.4.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1120,
      "height": 760,
      "resizable": true
    }
  },
  "permissions": [
    "cloud-storage:read",
    "cloud-storage:write",
    "cloud-storage:delete",
    "cloud-storage:share"
  ],
  "contributes": {
    "views": [
      {
        "id": "files",
        "title": "网盘",
        "route": "#/",
        "icon": "folder",
        "order": 210
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.cloud-storage/v1"
    ]
  },
  "navigation": {
    "location": "more",
    "viewId": "files"
  }
}
