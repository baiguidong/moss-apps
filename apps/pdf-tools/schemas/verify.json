{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "observations",
          "issues"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "observations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "issues": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "severity",
                "message"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "description": "生成下一批核验页图，可续跑；需同时提交 sourceSha256，不与 pages 同时使用。",
      "properties": {
        "startPage": {
          "type": "integer",
          "minimum": 1,
          "description": "省略时从第一张尚未生成的页面开始"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 8
        }
      }
    }
  }
}
