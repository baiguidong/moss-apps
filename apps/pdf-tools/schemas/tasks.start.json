{
  "type": "object",
  "properties": {
    "fileIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 50
    },
    "options": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "arrange",
            "split",
            "ocr",
            "extract",
            "form",
            "create",
            "render"
          ],
          "default": "arrange"
        },
        "language": {
          "type": "string",
          "enum": [
            "chi_sim+eng",
            "chi_sim",
            "eng"
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "description": "顺序即输出顺序；page 为从 0 开始的原页码。省略时处理选中文件的所有页面。",
          "items": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 0,
                "maximum": 499
              },
              "rotation": {
                "type": "integer",
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              }
            },
            "required": [
              "fileId",
              "page"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "type": "object",
          "description": "mode=form 时按 metadata.fields 的字段名填写；文字为 string，勾选为 boolean，多选为 string[]。",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "flatten": {
          "type": "boolean",
          "default": false,
          "description": "展平后不可继续编辑表单，默认保留交互字段。"
        },
        "content": {
          "type": "string",
          "maxLength": 200000,
          "description": "创建 PDF 时由模型生成正文，自动换行分页。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "parentId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    }
  },
  "required": [],
  "additionalProperties": false
}
