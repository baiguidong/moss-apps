{
  "schemaVersion": 2,
  "id": "moss.pdf",
  "version": "0.3.3",
  "displayName": "PDF 创作",
  "category": "knowledge",
  "keywords": [
    "PDF 创作",
    "PDF",
    "OCR",
    "合并",
    "拆分",
    "扫描件",
    "表单",
    "文字提取"
  ],
  "description": "在主会话中创建和整理 PDF，提取文字、识别扫描件、填写表单并检查页面。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/workspace.get.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "files.pick",
        "inputSchema": "schemas/files.pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "files.import",
        "inputSchema": "schemas/files.import.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "files.export",
        "inputSchema": "schemas/files.export.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/tasks.cancel.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/tasks.start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "resources.resolve",
        "inputSchema": "schemas/resource.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/tasks.cancel.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "tools": [
      {
        "id": "pdf_import",
        "title": "导入本地文件",
        "description": "复制指定的本地文件到此 App，返回可用于处理的文件 ID。原文件不修改。",
        "action": "files.import",
        "inputSchema": "schemas/files.import.json",
        "effect": "write"
      },
      {
        "id": "pdf_list",
        "title": "查看文件和任务",
        "description": "查看 PDF 文件、字段、任务和结果。成功文件的 displayMarkdown 可在主会话回复中展示，点击使用 Moss 通用预览。",
        "action": "workspace.get",
        "inputSchema": "schemas/workspace.get.json",
        "effect": "read"
      },
      {
        "id": "pdf_create",
        "title": "创建和处理 PDF",
        "description": "整理 PDF 页面、提取文字、离线 OCR 和填写交互表单，在 Moss 内查看和导出。 返回任务 ID，通过 pdf_list 查看进度。表单字段及当前值见文件 metadata.fields。",
        "action": "tasks.start",
        "inputSchema": "schemas/tasks.start.json",
        "effect": "write"
      },
      {
        "id": "pdf_export",
        "title": "导出 PDF 结果",
        "description": "用户需要导出时打开目录选择器保存指定文件。",
        "action": "files.export",
        "inputSchema": "schemas/files.export.json",
        "effect": "write"
      },
      {
        "id": "pdf_status",
        "title": "查看 PDF 任务",
        "description": "查询任务与结果，成功后调用 moss_present(result.presentation) 在右侧展示，回复使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/tasks.cancel.json",
        "effect": "read"
      },
      {
        "id": "pdf_inspect",
        "title": "读取 PDF 原文与引用",
        "description": "按页读取 PDF 原文并返回可点击的页码引用；只对生成 PDF 的成功任务使用。",
        "action": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "effect": "read"
      },
      {
        "id": "pdf_verify",
        "title": "检查 PDF 与记录核验",
        "description": "读取核验页图和检查状态；用 render 分批生成或续跑剩余页图，查看实际图片后用 pages 记录逐页观察与问题。",
        "action": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "effect": "write"
      }
    ],
    "skills": [
      {
        "id": "moss-pdf",
        "title": "PDF 创作",
        "description": "整理 PDF、提取文字、识别扫描件及填写已有 PDF 表单。",
        "path": "resources/skills/moss-pdf-tools/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "resourceProviders": [
      {
        "id": "pdf-files",
        "title": "PDF 处理结果",
        "schemes": [
          "moss-pdf"
        ],
        "resolveAction": "resources.resolve",
        "listAction": "composer.list"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ],
  "toolLoading": "always",
  "navigation": {
    "location": "none"
  },
  "overview": {
    "description": "在主会话中创建和整理 PDF，提取文字、识别扫描件、填写表单并检查页面。 结果直接在右侧展示，处理时保留原文件。",
    "examples": [
      "将这些 PDF 合并，删除空白页后导出。",
      "填写这份 PDF 表单，保留可编辑字段。",
      "识别扫描版合同的文字，并生成每页预览供检查。"
    ]
  }
}
