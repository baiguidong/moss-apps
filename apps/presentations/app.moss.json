{
  "schemaVersion": 2,
  "id": "moss.presentations",
  "version": "0.3.2",
  "displayName": "演示文稿",
  "category": "knowledge",
  "keywords": [
    "演示文稿",
    "创作",
    "内置"
  ],
  "description": "在主会话中创建和修改 PPT，预览幻灯片并导出可编辑文件。",
  "overview": {
    "description": "在主会话中创建和修改 PPT，预览幻灯片并导出可编辑文件。 用自然语言描述需求，成果在主会话和右侧展示。修改会保留原版本。",
    "examples": [
      "做一份 6 页的项目汇报 PPT，包含进展、风险和下一步。",
      "把这份方案整理成适合客户演示的幻灯片。",
      "将上一版演示文稿的第二页改为数据对比图。"
    ]
  },
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "toolLoading": "always",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-presentations",
        "title": "演示文稿创作",
        "description": "在主会话中创建和修改 PPT，预览幻灯片并导出可编辑文件。",
        "path": "resources/skills/moss-presentations/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "presentation_create",
        "title": "创建或修改演示文稿",
        "description": "创建、读取或修改 PPTX。mode=create 用 slides 定义文字、图片、表格、图表、形状和备注；mode=read/edit 使用 sourcePath，edit 支持 replacements 文字替换及 objectEdits 对象修改。返回任务 id，用 presentation_status 查询；对象修改前先用 presentation_inspect 定位，关联旧版本时传 parentId，源文件保留。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "presentation_status",
        "title": "查看任务",
        "description": "按任务 id 查询状态、日志和产物；成功后返回 PPTX 引用、内容索引及核验状态。交付前用 presentation_verify 检查实际幻灯片页图；展示使用 moss_present(result.presentation)，回复使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "presentation_list",
        "title": "列出作品",
        "description": "列出演示文稿任务的 id、输入参数、状态和产物清单，用于查找已有 PPTX 和历史版本。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "presentation_read",
        "title": "读取产物",
        "description": "按任务 id 和产物 index 读取幻灯片内容 JSON、创作参数或 HTML 预览等 UTF-8 文本，返回 text，单文件最多 2 MiB。读取 PPTX 对象及定位信息请用 presentation_inspect。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "presentation_export",
        "title": "导出作品",
        "description": "将任务 id 和产物 index 指定的 PPTX 或辅助文件复制到用户选择的目录；同名文件自动另取名。返回保存路径 path，取消选择时返回 canceled=true。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "presentation_guide",
        "title": "获取创作参数",
        "description": "获取 create/read/edit 模式、页面尺寸、英寸坐标单位和完整参数 JSON Schema（含支持的元素类型），用于构造 presentation_create 的输入。",
        "action": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "presentation_inspect",
        "title": "读取内容与原文引用",
        "description": "读取成功任务的 PPTX 内容索引，返回幻灯片对象 ID、文字、位置、对象详情及可点击引用。可按 page（从 1 开始）筛选，并用 offset/limit 分页；局部修改使用返回的对象 ID。",
        "action": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "effect": "read"
      },
      {
        "id": "presentation_verify",
        "title": "检查作品与记录核验",
        "description": "检查成功任务的 PPTX：仅传 id 获取实际幻灯片页图、文件指纹和核验进度；带 sourceSha256 和 render 分批生成页图；查看图片后带同一指纹及 pages 提交逐页观察和问题。生成页图与提交观察分开调用，发现错误后创建新版本再核验。",
        "action": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "effect": "write"
      }
    ],
    "resourceProviders": [
      {
        "id": "presentations",
        "title": "演示文稿作品",
        "schemes": [
          "moss-presentations"
        ],
        "listAction": "composer.list",
        "resolveAction": "composer.resolve"
      }
    ]
  },
  "navigation": {
    "location": "none"
  }
}
