{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "task",
        "tasks",
        "project",
        "projects",
        "artifact",
        "settings",
        "validate"
      ],
      "description": "task、project、validate 需要 id。artifact 需要任务 id 和从 0 开始的产物 index。tasks、projects 可传 offset 和 limit。settings 返回口播角色、音色、画幅和画质。当前会话工具不提供 FFmpeg 或 ffprobe 的版本号。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false
}
