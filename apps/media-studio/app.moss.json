    "protocols": [
      "moss.local-files/v1",
      "moss.agent/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1"
    ]
  },
  "permissions": [
    "local-files:pick",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:sessions:read",
    "agent:sessions:write",
    "agent:turns:read",
    "agent:turns:write",
    "platform:media",
    "video:runtime:read"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "多媒体工坊",
        "route": "#/",
        "order": 270
      },
      {
        "id": "moss-conversation",
        "title": "视频项目",
        "route": "#/workbench"
      }
    ],
    "tools": [
      {
        "id": "media_edit",
        "title": "剪辑与转换音视频",
        "description": "处理已有本地文件，可查询媒体信息、裁剪、压缩、提取音轨、生成 GIF 或转码。返回任务 ID。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "media_transcribe",
        "title": "录音转文字和字幕",
        "description": "将已有录音或视频转写为带时间戳的逐字稿、TXT、SRT 和 VTT。返回任务 ID。",
        "action": "media.transcribe",
        "inputSchema": "schemas/transcribe.json",
        "effect": "write"
      },
      {
        "id": "video_project_save",
        "title": "创建或修改视频项目",
        "description": "创建 kind=avatar 的数字人口播或 kind=animation 的分镜动画。修改时传项目 ID、最新 version 和讲稿字段、分镜表或单个镜头 HTML。返回新版本。",
        "action": "video.save",
        "inputSchema": "schemas/video-save.json",
        "effect": "write"
      },
      {
        "id": "video_render",
        "title": "渲染成片或口播配音",
        "description": "传已保存项目的 id 和 version。分镜动画只支持生成 MP4。数字人口播还可以单独试听配音。生成 MP4 返回任务 ID，口播录制时需打开项目预览。",
        "action": "video.render",
        "inputSchema": "schemas/video-render.json",
        "effect": "write"
      },
      {
        "id": "media_get",
        "title": "查询媒体任务、项目与产物",
        "description": "按 type 查询任务状态、项目版本和内容、文本产物或历史。settings 查看口播角色、音色和制作规格，validate 检查分镜结构。",
        "action": "media.get",
        "inputSchema": "schemas/media-get.json",
        "effect": "read"
      },
      {
        "id": "media_cancel",
        "title": "取消媒体任务",
        "description": "按任务 ID 取消排队或运行中的剪辑、转写、动画或口播任务。",
        "action": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "effect": "write"
      },
      {
        "id": "media_export",
        "title": "导出媒体产物",
        "description": "按任务 ID 和产物 index 保存到用户选择的目录，同名文件自动另取名。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "image_import",
        "title": "导入本地图片",
        "description": "将本地静态图片复制到图片工作区，返回供 image_process 使用的文件 ID。原件保留。",
        "action": "image.files.import",
        "inputSchema": "schemas/image/files.import.json",
        "effect": "write"
      },
      {
        "id": "image_get",
        "title": "查看图片、任务和结果",
        "description": "查看图片工作区的原图、处理进度和结果。结果文件 ID 可交给 image_export。",
        "action": "image.workspace.get",
        "inputSchema": "schemas/image/workspace.get.json",
        "effect": "read"
      },
      {
        "id": "image_process",
        "title": "批量处理图片",
        "description": "按 fileIds 提交图片任务，options 可组合格式压缩、裁剪缩放、旋转调色、降噪、水印和元数据处理。返回任务 ID，通过 image_get 查询。",
        "action": "image.tasks.start",
        "inputSchema": "schemas/image/tasks.start.json",
        "effect": "write"
      },
      {
        "id": "image_cancel",
        "title": "取消图片处理任务",
        "description": "传 image_process 返回的任务 ID，取消排队或运行中的图片任务。",
        "action": "image.tasks.cancel",
        "inputSchema": "schemas/image/tasks.cancel.json",
        "effect": "write"
      },
      {
        "id": "image_export",
        "title": "导出图片结果",
        "description": "传 image_get 返回的结果文件 ID，经目录选择器导出图片；保留已有同名文件。",
        "action": "image.files.export",
        "inputSchema": "schemas/image/files.export.json",
        "effect": "write"
      }
    ],
    "skills": [
      {
        "id": "moss-media-studio",
        "title": "多媒体工坊（音视频 CLI）",
        "description": "通过受管 CLI 使用完整引擎参数并与页面共享任务结果。",
        "path": "resources/skills/moss-media-studio/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "resourceProviders": [
      {
        "id": "studio-projects",
        "title": "口播项目",
        "schemes": [
          "moss-media-studio-avatar"
        ],
        "listAction": "composer.list",
        "resolveAction": "resources.resolve"
      },
      {
        "id": "animation-projects",
        "title": "分镜项目",
        "schemes": [
          "moss-media-studio-animation"
        ],
        "listAction": "animation.list",
        "resolveAction": "animation.resolve"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ],
  "appCapabilities": {
    "provides": [
      {
        "protocol": "moss.media-runtime/v1",
        "methods": [
          {
            "name": "video.get",
            "action": "video.runtime",
            "permission": "video:runtime:read",
            "effect": "read"
          }
        ]
      }
    ]
  }
}
