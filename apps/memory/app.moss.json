{
  "schemaVersion": 2,
  "id": "moss.memory",
  "version": "0.2.5",
  "displayName": "记忆",
  "category": "ai",
  "keywords": [
    "记忆",
    "Memory",
    "知识图谱",
    "MCP"
  ],
  "description": "在对话中保存和查找人物、项目与偏好，持续积累本地记忆。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.22.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1120,
      "height": 780,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "servers.list",
        "inputSchema": "schemas/servers.list.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "servers.save",
        "inputSchema": "schemas/servers.save.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "servers.inspect",
        "inputSchema": "schemas/servers.inspect.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "graph.read",
        "inputSchema": "schemas/graph.read.input.json",
        "outputSchema": "schemas/graph.read.result.json",
        "timeoutMs": 15000
      }
    ]
  },
  "permissions": [
    "mcp:read",
    "mcp:manage",
    "mcp:connect"
  ],
  "contributes": {
    "views": [
      {
        "id": "memory",
        "title": "记忆",
        "route": "#/",
        "icon": "brain",
        "order": 212
      }
    ],
    "settings": [
      {
        "id": "manage",
        "title": "记忆图谱",
        "viewId": "memory",
        "group": "tools",
        "presentation": {
          "width": "wide"
        }
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.mcp/v1",
      "moss.host/v1"
    ]
  },
  "navigation": {
    "location": "details"
  },
  "overview": {
    "description": "在对话中记录和查找长期记忆，通过图谱查看实体、观察记录与关联。记忆保存在本机，重启或更新后继续保留。"
  }
}
