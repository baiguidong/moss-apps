{
  "schemaVersion": 2,
  "id": "moss.spreadsheets",
  "version": "0.2.4",
  "displayName": "表格",
  "category": "knowledge",
  "keywords": [
    "表格",
    "创作",
    "内置"
  ],
  "description": "在主会话中创建、读取和修改 Excel 表格，计算公式并预览数据。",
  "overview": {
    "description": "在主会话中创建、读取和修改 Excel 表格，计算公式并预览数据。 用自然语言描述需求，成果在主会话和右侧展示。修改会保留原版本。",
    "examples": [
      "创建一份带公式的月度预算表，按分类汇总支出。",
      "分析这份销售表，整理各区域的增长情况。",
      "修改这份工作簿中的预算金额，保留已有样式和图表。"
    ]
  },
  "icon": "assets/icon.svg",
  "hostApi": "^3.23.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "toolLoading": "always",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "session.close",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      }
    ],
    "storage": "session"
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1",
      "moss.session-storage/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-spreadsheets",
        "title": "表格创作",
        "description": "在主会话中创建、读取和修改 Excel 表格，计算公式并预览数据。",
        "path": "resources/skills/moss-spreadsheets/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "spreadsheet_create",
        "title": "创建或修改表格",
        "description": "创建、读取或修改表格。mode=create 用 sheets 生成 XLSX，支持公式重算、格式和柱形/折线/饼图；mode=read/edit 用 sourcePath 导入 XLSX、CSV 或 TSV，edit 用 edits 修改单元格。返回任务 id，用 spreadsheet_status 查询。关联旧版本时传 parentId，源文件保留。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "spreadsheet_status",
        "title": "查看任务",
        "description": "按任务 id 查询状态、日志和产物；成功后返回工作表概况、文件引用及核验状态。交付前用 spreadsheet_verify 检查实际页图；展示使用 moss_present(result.presentation)，回复使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "spreadsheet_list",
        "title": "列出作品",
        "description": "列出表格任务的 id、输入参数、状态和产物清单，用于查找已有工作簿、源文件和历史版本。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "spreadsheet_read",
        "title": "读取产物",
        "description": "按任务 id 和产物 index 读取工作簿数据 JSON、创作参数或 HTML 预览等 UTF-8 文本，返回 text，单文件最多 2 MiB。按工作表或单元格范围读取内容请用 spreadsheet_inspect。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "spreadsheet_export",
        "title": "导出作品",
        "description": "将任务 id 和产物 index 指定的 XLSX 或辅助文件复制到用户选择的目录；同名文件自动另取名。返回保存路径 path，取消选择时返回 canceled=true。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "spreadsheet_guide",
        "title": "获取创作参数",
        "description": "获取 create/read/edit 模式、支持的图表类型和完整参数 JSON Schema，用于构造 spreadsheet_create 的输入。",
        "action": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "spreadsheet_inspect",
        "title": "读取内容与原文引用",
        "description": "读取成功任务的工作簿内容索引，返回单元格位置、值、公式、检查结果和可点击引用。可按 sheet 与 range（如 B2:C8）筛选，并用 offset/limit 分页；指定 range 时必须同时提供 sheet。",
        "action": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "effect": "read"
      },
      {
        "id": "spreadsheet_verify",
        "title": "检查作品与记录核验",
        "description": "检查成功任务的工作簿：仅传 id 获取实际打印页图、文件指纹和核验进度；带 sourceSha256 和 render 分批生成页图；查看图片后带同一指纹及 pages 提交逐页观察和问题。生成页图与提交观察分开调用，发现错误后创建新版本再核验。",
        "action": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "effect": "write"
      }
    ],
    "resourceProviders": [
      {
        "id": "spreadsheets",
        "title": "表格作品",
        "schemes": [
          "moss-spreadsheets"
        ],
        "listAction": "composer.list",
        "resolveAction": "composer.resolve"
      }
    ]
  },
  "navigation": {
    "location": "none"
  }
}
