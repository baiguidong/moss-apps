{
  "type": "object",
  "properties": {
    "uri": {
      "type": "string",
      "pattern": "^moss-spreadsheets://works/[a-f0-9-]{36}(\\?session=[a-zA-Z0-9._-]{1,128})?$",
      "maxLength": 240
    },
    "sheet": {
      "type": "string",
      "maxLength": 31
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    }
  },
  "required": [
    "uri",
    "sheet",
    "offset"
  ],
  "additionalProperties": false
}
