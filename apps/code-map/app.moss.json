{
  "schemaVersion": 2,
  "id": "moss.code-map",
  "version": "0.1.3",
  "displayName": "代码地图",
  "category": "development",
  "keywords": [
    "代码地图",
    "codebase-memory-mcp",
    "本地任务"
  ],
  "description": "索引本地仓库，浏览源码、调用关系与架构，使用同一 MCP 服务连接 Agent。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.14.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1200,
      "height": 820,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.mcp/v1"
    ]
  },
  "permissions": [
    "local-files:pick",
    "mcp:read",
    "mcp:manage",
    "mcp:connect"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "代码地图",
        "route": "#/",
        "order": 260
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ]
}
