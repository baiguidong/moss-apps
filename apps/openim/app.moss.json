{
  "schemaVersion": 2,
  "id": "moss.openim",
  "version": "0.1.1",
  "displayName": "即时消息",
  "description": "通过 OpenIM 与组织成员沟通，并为每个联系人配置个人 AI 回复策略。",
  "icon": "assets/icon.svg",
  "hostApi": "^1.2.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1180,
      "height": 780,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "instanceMode": "single",
    "targets": ["desktop"],
    "protocols": ["moss.agent/v1", "moss.channel/v1", "moss.openim/v1"],
    "actions": []
  },
  "permissions": [
    "openim:client",
    "openim:messages",
    "openim:files",
    "openim:screen-capture",
    "openim:media",
    "agent:catalog:read",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:turns:read",
    "agent:turns:write",
    "channel:sessions:read",
    "channel:sessions:write"
  ],
  "contributes": {
    "views": [
      {
        "id": "messages",
        "title": "即时消息",
        "route": "#/messages",
        "location": "more",
        "icon": "chat",
        "order": 190,
        "permission": "openim:client"
      }
    ],
    "settings": [
      {
        "id": "ai-replies",
        "title": "AI 回复设置",
        "viewId": "messages",
        "order": 190,
        "permission": "agent:bindings:write"
      }
    ]
  }
}
