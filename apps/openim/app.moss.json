{
  "schemaVersion": 2,
  "id": "moss.openim",
  "version": "0.2.15",
  "displayName": "即时消息",
  "category": "communication",
  "keywords": [
    "OpenIM",
    "即时消息",
    "通讯录",
    "Agent",
    "自动回复"
  ],
  "description": "通过 OpenIM 与组织成员沟通，并为每个联系人配置个人 AI 回复策略。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.4.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1180,
      "height": 780,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "status.get"
      },
      {
        "name": "session.ensure",
        "timeoutMs": 30000
      },
      {
        "name": "directory.list",
        "timeoutMs": 30000
      },
      {
        "name": "conversation.direct.prepare",
        "timeoutMs": 30000
      },
      {
        "name": "conversation.group.prepare",
        "timeoutMs": 30000
      },
      {
        "name": "sdk.call",
        "timeoutMs": 300000
      },
      {
        "name": "rtc.token"
      }
    ]
  },
  "permissions": [
    "openim:client",
    "agent:catalog:read",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:sessions:read",
    "agent:sessions:write",
    "agent:turns:read",
    "agent:turns:write",
    "platform:files",
    "platform:screen-capture",
    "platform:external-links",
    "platform:media"
  ],
  "contributes": {
    "views": [
      {
        "id": "messages",
        "title": "即时消息",
        "route": "#/messages",
        "icon": "chat",
        "order": 190
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.agent/v1",
      "moss.platform/v1",
      "moss.openim/v1"
    ]
  },
  "navigation": {
    "location": "more",
    "viewId": "messages"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "win32-x64",
    "linux-x64"
  ]
}
