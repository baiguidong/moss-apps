{
  "schemaVersion": 2,
  "id": "moss.anything-rag",
  "version": "0.1.3",
  "displayName": "RAG 知识库",
  "category": "knowledge",
  "keywords": ["RAG", "知识库", "中文检索", "语义搜索", "文档问答"],
  "description": "在本机整理和检索中文资料，回答问题时附上原文引用。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.23.1",
  "toolScope": "session",
  "publisher": { "id": "moss", "name": "Moss" },
  "ui": { "entry": "dist/ui/index.html", "window": { "width": 1260, "height": 820, "resizable": true } },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      { "name": "engine.status", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "engine.prepare", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "engine.retry", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "engine.cancel", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "spaces.list", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "spaces.create", "inputSchema": "schemas/space.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "spaces.update", "inputSchema": "schemas/space.update.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "spaces.delete", "inputSchema": "schemas/id.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "documents.list", "inputSchema": "schemas/documents.list.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "documents.read", "inputSchema": "schemas/documents.read.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "documents.search", "inputSchema": "schemas/documents.search.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "documents.delete", "inputSchema": "schemas/id.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "files.pick", "inputSchema": "schemas/files.pick.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "files.import", "inputSchema": "schemas/files.import.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "index.rebuild", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 300000 },
      { "name": "jobs.list", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "settings.get", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "settings.update", "inputSchema": "schemas/settings.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 },
      { "name": "resource.resolve", "inputSchema": "schemas/resource.resolve.input.json", "outputSchema": "schemas/result.json", "timeoutMs": 30000 }
    ]
  },
  "platforms": ["darwin-arm64", "linux-x64"],
  "permissions": ["local-files:pick", "local-files:open", "apps:invoke"],
  "contributes": {
    "views": [
      { "id": "rag", "title": "RAG 知识库", "route": "#/", "icon": "book-open", "order": 226 },
      { "id": "moss-settings", "title": "通用设置", "route": "#/moss-settings", "icon": "settings", "order": -1000 }
    ],
    "settings": [{ "id": "shared-settings", "title": "通用设置", "viewId": "moss-settings", "group": "apps", "order": -1000 }],
    "tools": [
      { "id": "list", "title": "列出 RAG 知识空间", "description": "列出知识空间和文档。", "action": "spaces.list", "effect": "read", "inputSchema": "schemas/empty.input.json", "outputSchema": "schemas/result.json" },
      { "id": "search", "title": "搜索 RAG 知识库", "description": "使用中文语义、关键词和可选重排搜索本地资料，返回证据片段和引用。", "action": "documents.search", "effect": "read", "inputSchema": "schemas/documents.search.input.json", "outputSchema": "schemas/result.json" },
      { "id": "read", "title": "读取 RAG 文档", "description": "按 resourceId 读取知识库文档正文和版本。", "action": "documents.read", "effect": "read", "inputSchema": "schemas/documents.read.input.json", "outputSchema": "schemas/result.json" },
      { "id": "import", "title": "导入 RAG 文档", "description": "将本地普通文件复制到 RAG 知识空间并建立索引。", "action": "files.import", "effect": "write", "inputSchema": "schemas/files.import.input.json", "outputSchema": "schemas/result.json" },
      { "id": "delete", "title": "删除 RAG 文档", "description": "删除受管文档副本和索引，原文件不受影响。", "action": "documents.delete", "effect": "destructive", "inputSchema": "schemas/id.input.json", "outputSchema": "schemas/result.json" }
    ],
    "resourceProviders": [{ "id": "documents", "schemes": ["moss-rag"], "resolveAction": "resource.resolve" }]
  },
  "host": { "protocols": ["moss.host/v1", "moss.runtimes/v1", "moss.local-files/v1", "moss.app-capabilities/v1"] },
  "appCapabilities": {
    "usesTools": [{ "appId": "moss.pdf", "tools": ["pdf_import", "pdf_create", "pdf_status", "pdf_inspect"] }]
  },
  "navigation": { "location": "more", "viewId": "rag" }
}
