{
  "schemaVersion": 2,
  "id": "moss.feishu",
  "version": "0.4.4",
  "displayName": "飞书",
  "description": "通过飞书私聊连接一个固定 Moss 会话并自动回复。",
  "icon": "assets/icon.svg",
  "hostApi": "^2.1.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 760,
      "height": 720,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "protocols": ["moss.agent/v1"],
    "actions": [
      { "name": "status.get" },
      { "name": "pairing.issue" },
      { "name": "pairing.list" },
      { "name": "pairing.revoke" }
    ],
    "configuration": {
      "schema": "schemas/config.json",
      "secrets": "schemas/secrets.json"
    }
  },
  "permissions": [
    "agent:catalog:read",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:turns:read",
    "agent:turns:write"
  ],
  "contributes": {
    "views": [
      {
        "id": "settings",
        "title": "飞书",
        "route": "#/settings",
        "location": "more",
        "icon": "forum",
        "order": 200
      }
    ],
    "settings": [
      {
        "id": "configuration",
        "title": "飞书设置",
        "viewId": "settings",
        "order": 200
      }
    ]
  }
}
