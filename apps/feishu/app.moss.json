{
  "schemaVersion": 2,
  "id": "moss.feishu",
  "version": "0.4.15",
  "displayName": "飞书",
  "category": "communication",
  "keywords": [
    "飞书",
    "机器人",
    "消息",
    "Agent",
    "移动端"
  ],
  "description": "通过飞书私聊连接一个固定 Moss 会话并自动回复。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.22.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 760,
      "height": 720,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "status.get"
      },
      {
        "name": "pairing.issue"
      },
      {
        "name": "pairing.list"
      },
      {
        "name": "pairing.revoke"
      }
    ],
    "configuration": {
      "schema": "schemas/config.json",
      "secrets": "schemas/secrets.json"
    }
  },
  "permissions": [
    "agent:catalog:read",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:turns:read",
    "agent:turns:write"
  ],
  "contributes": {
    "views": [
      {
        "id": "settings",
        "title": "飞书",
        "route": "#/configuration",
        "icon": "forum",
        "order": 200
      },
      {
        "id": "execution",
        "title": "执行权限",
        "route": "#/agent"
      }
    ],
    "settings": [
      {
        "id": "configuration",
        "title": "连接与配对",
        "viewId": "settings",
        "order": 200,
        "group": "integrations",
        "presentation": {
          "width": "wide"
        }
      },
      {
        "id": "execution-policy",
        "title": "执行权限",
        "group": "integrations",
        "viewId": "execution",
        "presentation": {
          "width": "wide"
        }
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.agent/v1"
    ]
  },
  "navigation": {
    "location": "details"
  },
  "overview": {
    "description": "通过飞书机器人与 Moss 对话。配置机器人凭据、配对用户，并设置这些会话可以使用的资源和执行权限。"
  }
}
