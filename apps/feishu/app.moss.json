{
  "schemaVersion": 2,
  "id": "moss.feishu",
  "version": "0.5.9",
  "displayName": "飞书",
  "category": "communication",
  "keywords": [
    "飞书",
    "机器人",
    "消息",
    "Agent",
    "移动端"
  ],
  "description": "在 Moss 中配置飞书机器人，支持扫码创建、手动填写和消息收发。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.23.1",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 460,
      "height": 720,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "status.get"
      },
      {
        "name": "feishu.bot-creator.start"
      },
      {
        "name": "feishu.bot-creator.poll"
      },
      {
        "name": "feishu.bot-creator.stop"
      },
      {
        "name": "channel.probe",
        "timeoutMs": 180000
      }
    ],
    "configuration": {
      "schema": "schemas/config.json",
      "secrets": "schemas/secrets.json"
    }
  },
  "permissions": [
    "agent:catalog:read",
    "agent:bindings:read",
    "agent:bindings:write",
    "agent:turns:read",
    "agent:turns:write",
    "platform:external-links"
  ],
  "contributes": {
    "views": [
      {
        "id": "channels",
        "title": "飞书",
        "route": "#/channels",
        "icon": "forum",
        "order": 200
      }
    ],
    "settings": [
      {
        "id": "channel-configuration",
        "title": "通道设置",
        "group": "integrations",
        "viewId": "channels"
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.agent/v1",
      "moss.platform/v1",
      "moss.runtimes/v1"
    ]
  },
  "navigation": {
    "location": "details"
  },
  "overview": {
    "description": "在 Moss 中配置飞书机器人，支持扫码创建、手动填写和消息收发。"
  },
  "discovery": {
    "group": "online",
    "kind": "app",
    "authMethods": [
      "browser",
      "credentials"
    ]
  }
}
