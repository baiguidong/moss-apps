{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["appId"],
  "properties": {
    "appId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "title": "飞书 App ID"
    },
    "allowedUsers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 },
      "uniqueItems": true,
      "default": []
    }
  }
}
