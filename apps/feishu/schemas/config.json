{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "appId": { "type": "string", "maxLength": 160 },
    "domain": { "enum": ["feishu", "lark"] },
    "enabled": { "type": "boolean" },
    "agentId": { "type": ["string", "null"] },
    "responseMode": { "enum": ["invoke", "stream"] },
    "showThinking": { "type": "boolean" },
    "showToolHints": { "type": "boolean" },
    "allowedTools": {
      "type": ["array", "null"],
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }
    },
    "allowedUsers": { "type": "array", "items": { "type": "string" } }
  }
}
