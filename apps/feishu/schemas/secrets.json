{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["appSecret"],
  "properties": {
    "appSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "title": "飞书 App Secret"
    },
    "encryptKey": {
      "type": "string",
      "maxLength": 512,
      "title": "事件 Encrypt Key"
    },
    "verificationToken": {
      "type": "string",
      "maxLength": 512,
      "title": "Verification Token"
    }
  }
}
