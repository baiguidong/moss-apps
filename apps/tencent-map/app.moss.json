{
  "schemaVersion": 2,
  "id": "moss.tencent-map",
  "version": "0.1.0",
  "displayName": "腾讯地图",
  "description": "接入腾讯地图各类位置服务，包括地点搜索、路线规划（驾车/公交/步行/骑行）、地址正逆解析、沿途搜索和天气查询等。",
  "category": "other",
  "discovery": {
    "group": "online",
    "authMethods": [
      "api-key"
    ]
  },
  "connectorApp": {
    "id": "tencent-map",
    "capabilities": [
      "mcp"
    ]
  },
  "keywords": [
    "tencent-map",
    "Tencent Map",
    "mcp"
  ],
  "icon": "assets/icon.png",
  "hostApi": "^3.15.0",
  "toolScope": "session",
  "navigation": {
    "location": "none"
  },
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "permissions": [
    "connector:use"
  ]
}
