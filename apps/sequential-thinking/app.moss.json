{
  "schemaVersion": 2,
  "id": "moss.sequential-thinking",
  "version": "0.1.2",
  "displayName": "分步思考",
  "category": "ai",
  "keywords": [
    "分步思考",
    "Sequential Thinking",
    "推理",
    "MCP"
  ],
  "description": "按需为复杂分析提供步骤记录、修正和分支工具。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.6.0",
  "toolScope": "global",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 760,
      "height": 720,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "servers.list",
        "inputSchema": "schemas/servers.list.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "servers.inspect",
        "inputSchema": "schemas/servers.inspect.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      }
    ]
  },
  "permissions": [
    "mcp:read",
    "mcp:manage",
    "mcp:connect"
  ],
  "contributes": {
    "views": [
      {
        "id": "settings",
        "title": "分步思考",
        "route": "#/settings",
        "icon": "psychology",
        "order": 218
      },
      {
        "id": "moss-settings",
        "title": "通用设置",
        "route": "#/moss-settings",
        "icon": "settings",
        "order": -1000
      }
    ],
    "settings": [
      {
        "id": "configuration",
        "title": "分步思考设置",
        "viewId": "settings",
        "group": "tools",
        "order": 218
      },
      {
        "id": "shared-settings",
        "title": "通用设置",
        "viewId": "moss-settings",
        "group": "apps",
        "order": -1000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.mcp/v1",
      "moss.host/v1"
    ]
  },
  "navigation": {
    "location": "settings",
    "viewId": "settings"
  }
}
