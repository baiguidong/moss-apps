{
  "schemaVersion": 2,
  "id": "moss.image-tools",
  "version": "0.1.3",
  "displayName": "图片工具",
  "category": "knowledge",
  "keywords": [
    "图片",
    "压缩",
    "裁剪",
    "sharp",
    "本地工具"
  ],
  "description": "批量转换、裁剪、缩放、旋转、调色、降噪与添加水印，在 Moss 内比较和导出结果。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.11.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1160,
      "height": 800,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/workspace.get.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "files.pick",
        "inputSchema": "schemas/files.pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "files.import",
        "inputSchema": "schemas/files.import.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "files.export",
        "inputSchema": "schemas/files.export.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/tasks.cancel.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/tasks.start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "图片工具",
        "route": "#/",
        "order": 240
      }
    ],
    "tools": [
      {
        "id": "files_import",
        "title": "导入本地文件",
        "description": "复制指定的本地文件到此 App，返回可用于处理的文件 ID。原文件不修改。",
        "action": "files.import",
        "inputSchema": "schemas/files.import.json",
        "effect": "write"
      },
      {
        "id": "workspace_get",
        "title": "查看文件和任务",
        "description": "查看此 App 已导入文件、处理任务与结果。",
        "action": "workspace.get",
        "inputSchema": "schemas/workspace.get.json",
        "effect": "read"
      },
      {
        "id": "tasks_start",
        "title": "图片工具处理任务",
        "description": "批量转换、裁剪、缩放、旋转、调色、降噪与添加水印，在 Moss 内比较和导出结果。 处理设置可组合；返回任务 ID，通过 workspace_get 查看进度与结果。",
        "action": "tasks.start",
        "inputSchema": "schemas/tasks.start.json",
        "effect": "write"
      },
      {
        "id": "tasks_cancel",
        "title": "取消图片处理",
        "description": "取消正在运行或排队的图片处理任务。",
        "action": "tasks.cancel",
        "inputSchema": "schemas/tasks.cancel.json",
        "effect": "write"
      },
      {
        "id": "files_export",
        "title": "导出图片结果",
        "description": "通过文件夹选择器导出图片处理结果，同名文件保留。",
        "action": "files.export",
        "inputSchema": "schemas/files.export.json",
        "effect": "write"
      }
    ]
  },
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ]
}
