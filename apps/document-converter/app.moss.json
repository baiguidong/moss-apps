{
  "schemaVersion": 2,
  "id": "moss.document-converter",
  "version": "0.1.2",
  "displayName": "文档格式转换",
  "category": "knowledge",
  "keywords": [
    "文档格式转换",
    "pandoc",
    "本地任务"
  ],
  "description": "通过 Pandoc 转换文档格式、设置排版与引用，在 Moss 查看和导出结果。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.14.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1200,
      "height": 820,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "文档格式转换",
        "route": "#/",
        "order": 260
      }
    ],
    "skills": [
      {
        "id": "moss-document-converter",
        "title": "文档格式转换",
        "description": "通过 Pandoc 转换文档格式、设置排版与引用，在 Moss 查看和导出结果。 可以查看 UI 失败任务、调整参数重试。",
        "path": "resources/skills/moss-document-converter/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ]
}
