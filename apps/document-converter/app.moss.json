{
  "schemaVersion": 2,
  "id": "moss.document",
  "version": "0.4.4",
  "displayName": "文档创作",
  "category": "knowledge",
  "keywords": [
    "文档创作",
    "文档格式转换",
    "pandoc",
    "本地任务",
    "创作",
    "Word",
    "Markdown",
    "PDF"
  ],
  "description": "在主会话中创作、修改和转换文档，生成 Word、PDF、HTML 与电子书。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.23.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "resources.resolve",
        "inputSchema": "schemas/resource.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "session.close",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      }
    ],
    "storage": "session"
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1",
      "moss.session-storage/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-document",
        "title": "文档创作",
        "description": "从需求编写文稿，使用 Pandoc 与 Typst 生成 DOCX/PDF，检查结果并继续编辑；也支持已有文档转换、模板与引用。",
        "path": "resources/skills/moss-document-converter/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "document_create",
        "title": "创作文档",
        "description": "从 Markdown 创作 DOCX、PDF、HTML、Markdown 或 EPUB（mode=author，传 title、content、to）；也可用 paths 批量转换或合并文档，或用 mode=review、sourcePath、edits/comments 为 DOCX 添加修订和批注。返回任务 id，用 document_status 查询。关联旧版本时传 parentId，原文件保留。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "document_status",
        "title": "查看文档任务",
        "description": "按任务 id 查询状态、日志和产物；成功的 DOCX/PDF 主文件还提供内容索引、页图及核验状态。交付前用 document_verify 检查实际页图；展示使用 moss_present(result.presentation)，回复使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "document_list",
        "title": "列出文档任务",
        "description": "列出文档任务的 id、输入参数、状态和产物清单，用于查找历史文档、原稿和导出文件。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "document_read",
        "title": "读取文档产物",
        "description": "按任务 id 和产物 index 读取 Markdown、HTML、JSON 等 UTF-8 文本文件，返回 text，单文件最多 2 MiB。读取 DOCX/PDF 正文请用 document_inspect。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "document_export",
        "title": "导出文档",
        "description": "将任务 id 和产物 index 指定的文档或辅助文件复制到用户选择的目录；同名文件自动另取名。返回保存路径 path，取消选择时返回 canceled=true。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "document_inspect",
        "title": "读取内容与原文引用",
        "description": "读取成功任务主文件的内容索引：DOCX 返回段落编号和文字，PDF 返回逐页原文；包含检查结果及可点击引用。支持 offset/limit 分页，PDF 可按 page 筛选。局部修订前先读取段落编号和原文。",
        "action": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "effect": "read"
      },
      {
        "id": "document_verify",
        "title": "检查作品与记录核验",
        "description": "检查成功任务的 DOCX/PDF 主文件：仅传 id 获取真实页图、文件指纹和核验进度；带 sourceSha256 和 render 分批生成页图；查看图片后带同一指纹及 pages 提交逐页观察和问题。生成页图与提交观察分开调用，发现错误后创建新版本再核验。",
        "action": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "effect": "write"
      }
    ],
    "resourceProviders": [
      {
        "id": "documents",
        "title": "文档结果",
        "schemes": [
          "moss-document"
        ],
        "resolveAction": "composer.resolve",
        "listAction": "composer.list"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ],
  "toolLoading": "always",
  "navigation": {
    "location": "none"
  },
  "overview": {
    "description": "在主会话中撰写、修改和转换文档，支持 Word、PDF、HTML 与电子书。源稿和历史版本会保留，成果在右侧预览。",
    "examples": [
      "写一份项目周报，包含进展、风险和下一步，生成 Word。",
      "根据这份 Word 文档调整结构，保留原文件并生成新版。",
      "把这份报告排版成适合打印的中文 PDF。"
    ]
  }
}
