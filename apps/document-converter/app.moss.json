{
  "schemaVersion": 2,
  "id": "moss.document",
  "version": "0.4.3",
  "displayName": "文档创作",
  "category": "knowledge",
  "keywords": [
    "文档创作",
    "文档格式转换",
    "pandoc",
    "本地任务",
    "创作",
    "Word",
    "Markdown",
    "PDF"
  ],
  "description": "在主会话中创作、修改和转换文档，生成 Word、PDF、HTML 与电子书。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "resources.resolve",
        "inputSchema": "schemas/resource.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-document",
        "title": "文档创作",
        "description": "从需求编写文稿，使用 Pandoc 与 Typst 生成 DOCX/PDF，检查结果并继续编辑；也支持已有文档转换、模板与引用。",
        "path": "resources/skills/moss-document-converter/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "document_create",
        "title": "创作文档",
        "description": "创作或转换文档。创作请传 mode=author、title、Markdown content 和 to；转换使用 paths。返回任务 ID。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "document_status",
        "title": "查看文档任务",
        "description": "读取任务结果、源文件、原文引用及检查状态。成功后查看实际页图，用 document_verify 记录核验；有错误先修改再交付。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "document_list",
        "title": "列出文档任务",
        "description": "列出文档历史、源内容与产物。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "document_read",
        "title": "读取文档产物",
        "description": "读取任务的 Markdown、HTML 或日志产物，可用于导入后继续修改。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "document_export",
        "title": "导出文档",
        "description": "打开目录选择器导出指定任务产物。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "document_inspect",
        "title": "读取内容与原文引用",
        "description": "读取已完成作品的段落、幻灯片对象或单元格及可点击的原文引用。局部编辑前先读取对象 ID / 段落号；可按页码、工作表和区域筛选。",
        "action": "creation.inspect",
        "inputSchema": "schemas/inspect.json",
        "effect": "read"
      },
      {
        "id": "document_verify",
        "title": "检查作品与记录核验",
        "description": "读取核验页图和检查状态；用 render 分批生成或续跑剩余页图，查看实际图片后用 pages 记录逐页观察与问题。",
        "action": "creation.verify",
        "inputSchema": "schemas/verify.json",
        "effect": "write"
      }
    ],
    "resourceProviders": [
      {
        "id": "documents",
        "title": "文档结果",
        "schemes": [
          "moss-document"
        ],
        "resolveAction": "composer.resolve",
        "listAction": "composer.list"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ],
  "toolLoading": "always",
  "navigation": {
    "location": "none"
  },
  "overview": {
    "description": "在主会话中撰写、修改和转换文档，支持 Word、PDF、HTML 与电子书。源稿和历史版本会保留，成果在右侧预览。",
    "examples": [
      "写一份项目周报，包含进展、风险和下一步，生成 Word。",
      "根据这份 Word 文档调整结构，保留原文件并生成新版。",
      "把这份报告排版成适合打印的中文 PDF。"
    ]
  }
}
