{
  "type": "object",
  "properties": {
    "collectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "collections",
        "sources",
        "resources"
      ],
      "default": "collections"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "kind"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "collections"
              }
            }
          }
        ]
      },
      "then": {
        "not": {
          "required": [
            "collectionId"
          ]
        }
      }
    }
  ]
}
