{
  "schemaVersion": 2,
  "id": "moss.visualize",
  "version": "0.2.0",
  "displayName": "可视化",
  "category": "data",
  "keywords": [
    "图表",
    "交互",
    "可视化",
    "HTML",
    "SVG",
    "数据"
  ],
  "description": "在主会话和右侧成果区创建、操作、修改交互图表与演示。",
  "overview": {
    "description": "直接在主会话里把想法和数据变成交互图表、原理演示与可视化界面。筛选数据、查看细节、对比方案，或拖动滑块观察结果变化。作品可以在会话和右侧成果区操作，也能导出为离线文件。用自然语言描述需求即可。",
    "examples": [
      "把这份销售 Excel 按月汇总，按地区画堆叠柱图。",
      "把不等间隔的销售日期画成趋势图，筛选后导出当前视图。",
      "用双方案定价演示比较收入和毛利，支持调整价格与销量。"
    ]
  },
  "icon": "assets/icon.svg",
  "hostApi": "^3.23.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "toolLoading": "always",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "session.close",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "files.import",
        "inputSchema": "schemas/inspect.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "views.export",
        "inputSchema": "schemas/view.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ],
    "storage": "session"
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1",
      "moss.session-storage/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-visualize",
        "title": "可视化创作",
        "description": "创建交互图表、数据表或离线 HTML 演示；保存源数据与图形并在 Moss 中预览。",
        "path": "resources/skills/moss-visualize/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "visualize_create",
        "title": "创建可视化",
        "description": "从会话 CSV/Excel 附件或 CSV 文本生成图表、表格，或用自包含 HTML 创作演示。可指定工作表、字段映射、按月汇总及地区分组。先用 visualize_inspect 查看附件字段。修改提供 parentId，旧版保留。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "visualize_status",
        "title": "查看可视化任务",
        "description": "按任务 id 查询生成状态、错误和产物。成功后调用 moss_present(result.presentation) 展示作品，并在回复中原样使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "visualize_list",
        "title": "列出可视化作品",
        "description": "列出可视化任务的 id、输入参数、状态和产物清单，用于查找已有作品或确定后续修改的 parentId。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "visualize_export",
        "title": "导出作品",
        "description": "将任务 id 和产物 index 指定的文件复制到用户通过目录选择器选择的位置；同名文件自动另取名。返回保存路径 path，取消选择时返回 canceled=true。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "visualize_templates",
        "title": "获取可视化模板",
        "description": "获取支持的图表类型、可改写的 HTML 演示模板，以及交互状态保存和追问接口的使用说明，用于准备 visualize_create 的输入。",
        "action": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "visualize_inspect",
        "title": "查看附件字段",
        "description": "将指定的 CSV 或 Excel 附件导入本会话，返回附件副本路径、工作表、表头和前五行，供确认字段映射。",
        "action": "files.import",
        "inputSchema": "schemas/inspect.json",
        "effect": "write"
      },
      {
        "id": "visualize_export_view",
        "title": "保存当前图表视图",
        "description": "根据原任务 id、交互状态 view 和格式 csv 或 svg，将当前视图保存到当前会话作品目录并返回可打开的链接。",
        "action": "views.export",
        "inputSchema": "schemas/view.json",
        "effect": "write"
      }
    ],
    "resourceProviders": [
      {
        "id": "visualizations",
        "title": "可视化作品",
        "schemes": [
          "moss-visualize"
        ],
        "listAction": "composer.list",
        "resolveAction": "composer.resolve"
      }
    ]
  },
  "navigation": {
    "location": "none"
  }
}
