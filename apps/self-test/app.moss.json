{
  "schemaVersion": 2,
  "id": "moss.self-test",
  "version": "0.1.21",
  "displayName": "AI 自测",
  "category": "diagnostics",
  "keywords": [
    "自测",
    "测试",
    "回归",
    "报告",
    "CDP"
  ],
  "description": "通过独立 Moss 实例执行 AI 界面测试，保留观察、截图和测试报告。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.22.0",
  "toolScope": "session",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "navigation": {
    "location": "details"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1120,
      "height": 820,
      "resizable": true
    }
  },
  "permissions": [
    "testing:control",
    "agent:permissions:bypass",
    "local-files:open"
  ],
  "host": {
    "protocols": [
      "moss.testing/v1",
      "moss.local-files/v1",
      "moss.host/v1"
    ]
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "catalog",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "status",
        "inputSchema": "schemas/run.json",
        "timeoutMs": 30000
      },
      {
        "name": "run.start",
        "inputSchema": "schemas/start.json",
        "timeoutMs": 30000
      },
      {
        "name": "run.stop",
        "inputSchema": "schemas/run.json",
        "timeoutMs": 30000
      },
      {
        "name": "session.open",
        "inputSchema": "schemas/run.json",
        "timeoutMs": 30000
      },
      {
        "name": "report.open",
        "inputSchema": "schemas/run.json",
        "timeoutMs": 30000
      },
      {
        "name": "report.reveal",
        "inputSchema": "schemas/run.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.status",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.frame",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.input",
        "inputSchema": "schemas/instance-input.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.open",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.close",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.sync",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "instance.reset",
        "inputSchema": "schemas/empty.json",
        "timeoutMs": 30000
      },
      {
        "name": "self-test",
        "inputSchema": "schemas/self-test.json",
        "timeoutMs": 30000
      }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "self-test",
        "title": "AI 自测",
        "route": "#/self-test",
        "icon": "clipboard-check"
      }
    ],
    "settings": [
      {
        "id": "manage",
        "title": "自测工作台",
        "viewId": "self-test",
        "group": "apps",
        "presentation": {
          "width": "wide"
        }
      }
    ],
    "tools": [
      {
        "id": "self_test",
        "title": "AI 自测",
        "description": "读取自测清单、启动独立 Moss 测试实例、查询报告、提交本轮观察或停止自测。start 异步返回 runId，使用 status 查询，不能为轮询重复 start。只有专用控制会话可 record，passed 必须逐条验证预期并提供本轮截图。停止保留测试窗口和数据。",
        "action": "self-test",
        "effect": "write",
        "permission": "testing:control",
        "inputSchema": "schemas/self-test.json"
      }
    ]
  },
  "overview": {
    "description": "选择检查项目，在独立测试环境中运行自测，查看实时进度、测试窗口和报告。"
  }
}
