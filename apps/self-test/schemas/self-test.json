{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "start",
        "status",
        "record",
        "stop",
        "review",
        "inspect"
      ]
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "boolean"
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "index",
          "passed",
          "actual"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 8000
    },
    "reset_data": {
      "type": "boolean",
      "default": true,
      "description": "开始新一轮前清理上轮测试数据，保留安装环境及历史报告。"
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 10,
            "maxLength": 8000
          }
        },
        "required": [
          "case_id",
          "status",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "correction": {
      "type": "object",
      "description": "仅纠正测试定位或断言错误时使用；真实产品缺陷即使重试成功仍为 failed。",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "test-error"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 15,
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false
}
