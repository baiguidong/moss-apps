{
  "schemaVersion": 2,
  "id": "moss.file-management",
  "version": "0.1.0",
  "displayName": "文件管理",
  "category": "files",
  "discovery": {
    "group": "local"
  },
  "keywords": [
    "文件管理",
    "文件清理",
    "备份",
    "恢复",
    "重复文件",
    "Czkawka",
    "Restic"
  ],
  "description": "扫描与清理本地目录、备份文件、浏览快照并恢复。页面和 Agent 共用任务记录与报告。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1200,
      "height": 820,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "workspace.summary",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "cleanup.start",
        "inputSchema": "schemas/cleanup-start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "cleanup.scan",
        "inputSchema": "schemas/cleanup-scan.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "cleanup.execute",
        "inputSchema": "schemas/cleanup-start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "cleanup.apply",
        "inputSchema": "schemas/cleanup-apply.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 30000
      },
      {
        "name": "history.import",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "agent.catalog",
        "inputSchema": "schemas/catalog.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "cleanup.video.status",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 15000
      }
    ],
    "configuration": {
      "secrets": "schemas/secrets.json"
    }
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1",
      "moss.app-capabilities/v1"
    ]
  },
  "permissions": [
    "local-files:pick",
    "apps:invoke"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "文件管理",
        "route": "#/cleanup",
        "order": 270
      }
    ],
    "tools": [
      {
        "id": "run",
        "title": "运行备份与恢复任务",
        "description": "提交 Restic 任务。支持初始化备份库、备份目录、列出快照或文件、校验和恢复。返回任务 ID 后用 filemanagement_task 查询状态，恢复可能覆盖重名文件。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "task",
        "title": "查看文件管理任务",
        "description": "按 id 查看扫描、清理、备份或恢复任务的状态、参数、日志和产物。任务仍在运行时继续查询，succeeded 表示已完成。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "catalog",
        "title": "查看文件管理能力",
        "description": "列出备份操作和清理类别。填写 cleanupCommand 可查看指定清理类别的选项和子命令。 相似视频和视频优化需要已安装并启用的多媒体工坊（moss.media-studio）。",
        "action": "agent.catalog",
        "inputSchema": "schemas/catalog.json",
        "effect": "read"
      },
      {
        "id": "list",
        "title": "列出文件管理任务",
        "description": "列出页面和 Agent 共用的近期清理、备份和恢复任务。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "cancel",
        "title": "取消文件管理任务",
        "description": "请求取消指定的排队中或运行中任务。随后查询实际状态和已产生的结果。",
        "action": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "effect": "write"
      },
      {
        "id": "read-result",
        "title": "读取文件管理任务的文本或 JSON 报告",
        "description": "按任务 ID 和产物序号读取指定报告，单文件最大 2 MiB。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "cleanup_scan",
        "title": "扫描本地文件",
        "description": "只读扫描指定目录，查找重复文件、大文件、相似图片等。返回任务 ID，用 filemanagement_task 查看结果和报告。 相似视频和视频优化需要已安装并启用的多媒体工坊（moss.media-studio）。",
        "action": "cleanup.scan",
        "inputSchema": "schemas/cleanup-scan.json",
        "effect": "read"
      },
      {
        "id": "cleanup_run",
        "title": "执行文件清理策略",
        "description": "按已确认的目录和策略执行删除、改名、修复或优化。操作会重新扫描目录。执行前核对用户授权，传入 confirmChanges: true；支持预演的选项可用 dry-run。返回任务 ID，用 filemanagement_task 查询结果。 相似视频和视频优化需要已安装并启用的多媒体工坊（moss.media-studio）。",
        "action": "cleanup.execute",
        "inputSchema": "schemas/cleanup-start.json",
        "effect": "write"
      }
    ]
  },
  "platforms": [
    "darwin-arm64",
    "linux-x64"
  ],
  "appCapabilities": {
    "requires": [
      {
        "protocol": "moss.media-runtime/v1",
        "optional": true
      }
    ]
  }
}
