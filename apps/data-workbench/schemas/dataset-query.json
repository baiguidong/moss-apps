{
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId"],
  "properties": {
    "sourceId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "expectedRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "columns": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
    "filters": { "type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["column", "op", "value"],
      "properties": {
        "column": { "type": "string" },
        "op": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
        "value": { "type": ["string", "number", "boolean", "null"] }
      }
    } },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 100000 }
  }
}
