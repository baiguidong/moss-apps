{
  "schemaVersion": 2,
  "id": "moss.templates",
  "version": "0.2.2",
  "displayName": "模板",
  "category": "knowledge",
  "keywords": [
    "模板",
    "创作",
    "内置"
  ],
  "description": "从参考文档、表格、演示文稿和内容中保存模板，在主会话复用。",
  "overview": {
    "description": "从参考文档、表格、演示文稿和内容中保存模板，在主会话复用。 用自然语言描述需求，成果在主会话和右侧展示。修改会保留原版本。",
    "examples": [
      "把这份周报保存为可重复使用的模板。",
      "使用刚保存的模板，生成本周的项目周报。",
      "更新这个模板中的公司名称和标题样式。"
    ]
  },
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "global",
  "toolLoading": "always",
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "composer.list",
        "inputSchema": "schemas/composer-list.json",
        "outputSchema": "schemas/result.json"
      },
      {
        "name": "composer.resolve",
        "inputSchema": "schemas/composer-resolve.json",
        "outputSchema": "schemas/result.json"
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1",
      "moss.runtime/v1",
      "moss.artifacts/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "skills": [
      {
        "id": "moss-templates",
        "title": "模板创作",
        "description": "从参考文档、表格、演示文稿和内容中保存模板，在主会话复用。",
        "path": "resources/skills/moss-templates/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ],
    "tools": [
      {
        "id": "template_create",
        "title": "创建或修改模板",
        "description": "保存、应用或更新可复用模板。mode=save 接收 sourcePath 或 content 及复用说明；mode=use 接收 templateId 和 values，替换文本中的 {{变量名}}，Office 参考文件需交给对应创作工具继续生成；mode=update 使用 templateId，并传 parentId=templateId 保留版本关联。返回任务 id，用 template_status 查询；保存和更新会生成待安装的模板技能包。",
        "action": "tasks.start",
        "inputSchema": "schemas/start.json",
        "effect": "write"
      },
      {
        "id": "template_status",
        "title": "查看任务",
        "description": "按任务 id 查询状态、日志、参考文件和模板说明。保存或更新成功后还返回 result.skillBundle，需按其 nextStep 安装后才可作为个人技能使用。展示使用 moss_present(result.presentation)，回复使用 result.displayMarkdown。",
        "action": "tasks.get",
        "inputSchema": "schemas/id.json",
        "effect": "read"
      },
      {
        "id": "template_list",
        "title": "列出作品",
        "description": "列出模板任务的 id、输入参数、状态和产物清单，用于查找可复用模板及历史版本；应用或更新时以原任务 id 作为 templateId。",
        "action": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      },
      {
        "id": "template_read",
        "title": "读取产物",
        "description": "按任务 id 和产物 index 读取模板参数 JSON、Markdown 技能说明、文本参考或 HTML 预览，返回 text，单文件最多 2 MiB。Office、PDF、图片和 ZIP 产物应使用文件引用或导出。",
        "action": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "effect": "read"
      },
      {
        "id": "template_export",
        "title": "导出作品",
        "description": "将任务 id 和产物 index 指定的参考文件、模板说明或技能 ZIP 复制到用户选择的目录；同名文件自动另取名。返回保存路径 path，取消选择时返回 canceled=true。",
        "action": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "effect": "write"
      },
      {
        "id": "template_guide",
        "title": "获取创作参数",
        "description": "获取 save/use/update 模式、支持的参考文件格式和完整参数 JSON Schema，用于构造 template_create 的输入。",
        "action": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "effect": "read"
      }
    ],
    "resourceProviders": [
      {
        "id": "templates",
        "title": "模板作品",
        "schemes": [
          "moss-templates"
        ],
        "listAction": "composer.list",
        "resolveAction": "composer.resolve"
      }
    ]
  },
  "navigation": {
    "location": "none"
  }
}
