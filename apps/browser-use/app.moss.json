{
  "schemaVersion": 2,
  "id": "moss.browser-use",
  "version": "0.1.9",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "win32-x64",
    "linux-x64"
  ],
  "displayName": "网页操控",
  "category": "automation",
  "keywords": [
    "浏览器",
    "Browser Use",
    "Chrome",
    "Playwright",
    "网页操控"
  ],
  "description": "操作网页时打开保留登录状态的专用浏览器，或连接日常 Chrome 操作网页。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.21.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "servers.list",
        "inputSchema": "schemas/servers.list.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "servers.save",
        "inputSchema": "schemas/servers.save.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "servers.inspect",
        "inputSchema": "schemas/servers.inspect.input.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "settings.read",
        "inputSchema": "schemas/servers.list.input.json",
        "outputSchema": "schemas/settings-result.json",
        "timeoutMs": 65000
      },
      {
        "name": "settings.save",
        "inputSchema": "schemas/connection.json",
        "outputSchema": "schemas/settings-result.json",
        "timeoutMs": 65000
      }
    ],
    "configuration": {
      "secrets": "schemas/secrets.json"
    }
  },
  "permissions": [
    "mcp:read",
    "mcp:manage",
    "mcp:connect"
  ],
  "contributes": {
    "settings": [
      {
        "id": "connection",
        "title": "浏览器连接设置",
        "group": "tools",
        "permission": "mcp:manage",
        "form": {
          "readAction": "settings.read",
          "saveAction": "settings.save"
        }
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.mcp/v1",
      "moss.host/v1"
    ]
  },
  "navigation": {
    "location": "none"
  },
  "overview": {
    "description": "通过专用浏览器、日常 Chrome 扩展或已有 CDP 服务操作网页。专用浏览器保留登录状态，在操作网页时打开。可读取页面、填写表单、点击操作和截图。",
    "examples": [
      "打开网站，帮我查找需要的信息",
      "读取当前页面，整理成摘要",
      "填写表单，并截取页面供我检查"
    ]
  }
}
