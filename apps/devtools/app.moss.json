{
  "schemaVersion": 2,
  "id": "moss.devtools",
  "version": "0.2.0",
  "displayName": "开发工具",
  "description": "时间戳、Base64、AES、JSON 与 HTTP 调试，常用开发工具集中使用。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.0.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1080,
      "height": 740,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "timestamp.convert",
        "inputSchema": "schemas/timestamp.convert.input.json",
        "outputSchema": "schemas/timestamp.convert.output.json",
        "timeoutMs": 15000
      },
      {
        "name": "base64.convert",
        "inputSchema": "schemas/base64.convert.input.json",
        "outputSchema": "schemas/base64.convert.output.json",
        "timeoutMs": 15000
      },
      {
        "name": "json.process",
        "inputSchema": "schemas/json.process.input.json",
        "outputSchema": "schemas/json.process.output.json",
        "timeoutMs": 15000
      },
      {
        "name": "aes.process",
        "inputSchema": "schemas/aes.process.input.json",
        "outputSchema": "schemas/aes.process.output.json",
        "timeoutMs": 15000
      },
      {
        "name": "request.send",
        "inputSchema": "schemas/request.send.input.json",
        "outputSchema": "schemas/request.send.output.json",
        "timeoutMs": 135000
      }
    ]
  },
  "permissions": [],
  "contributes": {
    "views": [
      {
        "id": "tools",
        "title": "开发工具",
        "route": "#/timestamp",
        "icon": "braces",
        "order": 220
      }
    ]
  }
}
