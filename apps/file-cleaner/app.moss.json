{
  "schemaVersion": 2,
  "id": "moss.file-cleaner",
  "version": "0.1.1",
  "displayName": "文件清理",
  "category": "knowledge",
  "keywords": [
    "文件清理",
    "czkawka",
    "本地任务"
  ],
  "description": "扫描重复文件、相似图片和磁盘问题，查看结果并按策略清理。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.14.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "toolScope": "session",
  "navigation": {
    "location": "more",
    "viewId": "workspace"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1200,
      "height": 820,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "persistent",
    "actions": [
      {
        "name": "workspace.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "catalog.get",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "engine.prepare",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "paths.pick",
        "inputSchema": "schemas/pick.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.start",
        "inputSchema": "schemas/start.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.get",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "tasks.cancel",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.read",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "artifacts.export",
        "inputSchema": "schemas/artifact.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.local-files/v1"
    ]
  },
  "permissions": [
    "local-files:pick"
  ],
  "contributes": {
    "views": [
      {
        "id": "workspace",
        "title": "文件清理",
        "route": "#/",
        "order": 260
      }
    ],
    "skills": [
      {
        "id": "moss-file-cleaner",
        "title": "文件清理",
        "description": "扫描重复文件、相似图片和磁盘问题，查看结果并按策略清理。 可以查看 UI 失败任务、调整参数重试。",
        "path": "resources/skills/moss-file-cleaner/SKILL.md",
        "cli": "dist/backend/cli.mjs"
      }
    ]
  },
  "platforms": [
    "darwin-arm64"
  ]
}
