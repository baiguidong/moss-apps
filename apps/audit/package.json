  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@tailwindcss/vite": "4.2.0",
