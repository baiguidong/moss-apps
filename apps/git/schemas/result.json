{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "required": [
        "servers",
        "preparation",
        "settings"
      ],
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "enabled",
              "config",
              "updatedAt"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "config": {
                "type": "object"
              },
              "updatedAt": {
                "type": "number"
              }
            }
          }
        },
        "preparation": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "configuring",
                "connecting",
                "ready",
                "failed",
                "waiting"
              ]
            },
            "error": {
              "type": "string"
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directories",
            "disabledTools",
            "gitExecutable"
          ],
          "properties": {
            "directories": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "disabledTools": {
              "type": "array",
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "gitExecutable": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
