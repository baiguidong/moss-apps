{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "maxLength": 30
    },
    "skin": {
      "enum": [
        "moss",
        "robot",
        "orb"
      ]
    },
    "personality": {
      "type": "string",
      "maxLength": 500
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "enum": [
            "warm",
            "playful",
            "concise"
          ]
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "assistantName": {
          "type": [
            "string",
            "null"
          ]
        },
        "configEnabled": {
          "type": "boolean"
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "permissionMode": {
          "enum": [
            "bypassPermissions",
            "default",
            "acceptEdits",
            "dontAsk"
          ]
        },
        "toolAccess": {
          "enum": [
            "all",
            "selected"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "revision"
  ]
}
