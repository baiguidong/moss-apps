{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,160}$"
    },
    "callId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,160}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "query": {
      "type": "string",
      "maxLength": 500
    },
    "sinceRevision": {
      "type": "number"
    },
    "sinceRevisionToken": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
