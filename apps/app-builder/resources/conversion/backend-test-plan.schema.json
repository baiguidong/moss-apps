{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moss App Backend Test Plan",
  "type": "object",
  "required": ["schemaVersion", "appId", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "category", "required", "input", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "action": { "type": "string", "minLength": 1 },
          "category": { "enum": ["success", "invalid-input", "dependency", "failure", "timeout", "integration", "equivalence"] },
          "required": { "const": true },
          "input": { "type": "object" },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
          "expect": {
            "type": "object",
            "required": ["assertions"],
            "properties": {
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "operator"],
                  "properties": {
                    "path": { "type": "string" },
                    "operator": { "enum": ["exists", "equals", "type", "nonEmpty", "minItems"] },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
