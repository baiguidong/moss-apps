{
  "schemaVersion": 2,
  "id": "moss.mcp",
  "version": "0.1.15",
  "displayName": "MCP 管理",
  "category": "ai",
  "keywords": [
    "MCP",
    "工具",
    "集成",
    "连接",
    "自动化"
  ],
  "description": "管理 MCP 服务连接，让常用工具融入对话。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.22.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1120,
      "height": 780,
      "resizable": true
    }
  },
  "permissions": [
    "mcp:read",
    "mcp:manage",
    "mcp:connect",
    "mcp:auth"
  ],
  "contributes": {
    "views": [
      {
        "id": "connections",
        "title": "MCP 管理",
        "route": "#/",
        "icon": "plug",
        "order": 220
      }
    ],
    "settings": [
      {
        "id": "manage",
        "title": "管理服务",
        "viewId": "connections",
        "group": "integrations",
        "presentation": {
          "width": "wide"
        }
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.mcp/v1",
      "moss.host/v1"
    ]
  },
  "navigation": {
    "location": "details"
  },
  "toolSelection": "services",
  "overview": {
    "description": "管理本地或远程 MCP 服务，添加连接、配置凭据并完成授权。在会话中使用各服务提供的工具。"
  }
}
