{
  "schemaVersion": 2,
  "id": "moss.h3yun-connector",
  "version": "0.1.0",
  "displayName": "氚云",
  "description": "通过氚云连接器，将日常业务快速构建为可配置、可协同、可追踪的数字化应用。支持快速创建应用表单、管理业务数据、以流程驱动审批与任务流转，适用于客户、项目、采购、库存、售后等多类业务管理场景。",
  "category": "other",
  "discovery": {
    "group": "online",
    "authMethods": [
      "api-key"
    ]
  },
  "connectorApp": {
    "id": "h3yun-connector",
    "capabilities": [
      "mcp",
      "skills"
    ]
  },
  "keywords": [
    "h3yun-connector",
    "H3Yun",
    "mcp",
    "skills"
  ],
  "icon": "assets/icon.svg",
  "hostApi": "^3.15.0",
  "toolScope": "session",
  "navigation": {
    "location": "none"
  },
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "permissions": [
    "connector:use"
  ]
}
