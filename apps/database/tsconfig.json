{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
