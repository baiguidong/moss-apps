{
  "schemaVersion": 2,
  "id": "moss.database",
  "version": "0.2.3",
  "displayName": "数据库查询",
  "category": "data",
  "keywords": [
    "数据库",
    "DBHub",
    "SQL",
    "SQLite",
    "PostgreSQL",
    "MySQL",
    "MariaDB",
    "SQL Server",
    "Oracle",
    "MCP"
  ],
  "description": "使用 DBHub 查询 SQLite、PostgreSQL、MySQL 等数据库，查看表结构和分析数据。",
  "icon": "assets/icon.svg",
  "hostApi": "^3.22.0",
  "publisher": {
    "id": "moss",
    "name": "Moss"
  },
  "ui": {
    "entry": "dist/ui/index.html",
    "window": {
      "width": 1120,
      "height": 780,
      "resizable": true
    }
  },
  "backend": {
    "entry": "dist/backend/main.mjs",
    "runtime": "node",
    "apiVersion": 1,
    "lifecycle": "on-demand",
    "actions": [
      {
        "name": "connections.list",
        "inputSchema": "schemas/empty.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "connections.save",
        "inputSchema": "schemas/save.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "connections.inspect",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 300000
      },
      {
        "name": "connections.remove",
        "inputSchema": "schemas/id.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      },
      {
        "name": "connections.set-enabled",
        "inputSchema": "schemas/toggle.json",
        "outputSchema": "schemas/result.json",
        "timeoutMs": 65000
      }
    ],
    "configuration": {
      "secrets": "schemas/secrets.json"
    }
  },
  "permissions": [
    "mcp:read",
    "mcp:manage",
    "mcp:connect"
  ],
  "contributes": {
    "views": [
      {
        "id": "connections",
        "title": "数据库连接",
        "route": "#/",
        "icon": "plug",
        "order": 220
      }
    ],
    "settings": [
      {
        "id": "manage",
        "title": "数据库连接",
        "viewId": "connections",
        "group": "integrations",
        "presentation": {
          "width": "wide"
        }
      }
    ]
  },
  "host": {
    "protocols": [
      "moss.mcp/v1",
      "moss.host/v1"
    ]
  },
  "navigation": {
    "location": "details"
  },
  "toolScope": "session",
  "overview": {
    "description": "配置多个数据库连接，在对话中查询数据。每个连接独立设置只读策略、行数上限和查询超时。"
  }
}
